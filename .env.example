# Zugangsdaten für den Versand des Kontaktformulars (src/pages/api/kontakt.ts).
#
# Diese Datei ist nur die VORLAGE — sie enthält keine echten Werte und darf
# committet werden. Die echten Werte gehören in eine lokale `.env` (gitignored)
# und in die Vercel-Projekteinstellungen (Settings → Environment Variables).
#
# Fehlt auch nur eine der vier Pflichtangaben, verschickt der Endpoint NICHTS
# und antwortet mit einer ehrlichen Fehlermeldung. Er tut nie so, als sei die
# Nachricht angekommen.

# Postfach, über das verschickt wird (Hostinger)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@keanodecker.com
SMTP_PASS=

# Wohin die Anfragen gehen — die Adresse des Gasthofs
KONTAKT_EMPFAENGER=info@wetteraperle.de

# Optional: abweichende Absenderadresse (Vorgabe ist SMTP_USER).
# Sie muss zum SMTP-Konto gehören, sonst greifen SPF/DKIM nicht und die
# Mail landet im Spam. Der Gast steht ohnehin in "Antworten an".
KONTAKT_ABSENDER=
