# Zugangsdaten für den Versand des Kontaktformulars (src/pages/api/kontakt.ts).
#
# Diese Datei ist nur die VORLAGE — sie enthält keine echten Werte und darf
# committet werden. Die echten Werte gehören in eine lokale `.env` (gitignored)
# und in die Vercel-Projekteinstellungen (Settings → Environment Variables).
#
# ⚠️ Nach dem Ändern einer Variable auf Vercel muss NEU DEPLOYT werden — laufende
# Deployments bekommen den neuen Wert nicht nachgereicht.
#
# Fehlt eine der beiden Pflichtangaben, verschickt der Endpoint NICHTS und
# antwortet mit einer ehrlichen Fehlermeldung. Er tut nie so, als sei die
# Nachricht angekommen.

# Resend-API-Key (https://resend.com → API Keys). „Sending access" genügt.
# Er wird als Bearer-Token gegen https://api.resend.com/emails geschickt.
RESEND_API_KEY=

# Wohin die Anfragen gehen — die Adresse des Gasthofs
KONTAKT_EMPFAENGER=info@wetteraperle.de

# Absenderadresse. Muss auf der bei Resend VERIFIZIERTEN Domain liegen, sonst
# lehnt Resend mit 422 ab. Ein echtes Postfach braucht es dafür nicht.
# Ohne Angabe wird formular@wetteraperle.de verwendet.
# Der Gast steht ohnehin in „Antworten an" (reply_to).
KONTAKT_ABSENDER=formular@wetteraperle.de
