---
import { ausUrl, zahl } from '../i18n/ui';

interface Props {
	class?: string;
	dark?: boolean;
}

const { class: className = '', dark = false } = Astro.props;
const { sprache, t } = ausUrl(Astro.url);
---

<div
	class:list={[
		'inline-flex items-center gap-2 rounded-full px-4 py-2 text-sm font-semibold shadow-lg backdrop-blur',
		dark ? 'bg-ink-900/70 text-cream-50' : 'bg-cream-50/95 text-ink-900',
		className,
	]}
>
	<span class="flex text-orange-500" aria-hidden="true">
		{Array.from({ length: 5 }).map(() => (
			<svg viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4">
				<path
					d="M10 1.5l2.59 5.25 5.79.84-4.19 4.09.99 5.77L10 14.9l-5.18 2.55.99-5.77L1.62 7.6l5.79-.84L10 1.5z"
				></path>
			</svg>
		))}
	</span>
	<span>{zahl(sprache, '4,9')} · {t.allgemein.googleBewertungen}</span>
</div>
