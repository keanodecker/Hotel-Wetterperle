---
import { Image, getImage } from 'astro:assets';
import type { RoomImage } from '../data/rooms';
import { ausUrl } from '../i18n/ui';

interface Props {
	bilder: RoomImage[];
	/** Zimmername, wird nur fuer Bedientexte gebraucht. */
	name: string;
}

const { bilder, name } = Astro.props;
const { t } = ausUrl(Astro.url);

/*
 * Die Lightbox (src/scripts/galerie-lightbox.ts) laeuft im Browser und kann
 * nicht auf `t` zugreifen. Deshalb haengen ihre Beschriftungen als
 * data-Attribut an der Galerie und werden dort ausgelesen - so bleibt die
 * Sprache auch dort richtig, ohne dass das Skript zweimal existiert.
 */
const bedientexte = {
	schliessen: t.galerie.schliessen,
	vorheriges: t.galerie.vorheriges,
	naechstes: t.galerie.naechstes,
	// Platzhalter {i} / {n} werden im Skript ersetzt.
	bildVon: t.galerie.bildVon('{i}', '{n}'),
};

const [titelbild, ...weitere] = bilder;

/*
 * Fuer die Lightbox erzeugen wir einmalig eine 1600-px-WebP-Fassung pro Bild.
 * Die URL haengt nur als data-Attribut am Thumbnail - geladen wird sie erst,
 * wenn jemand das Bild wirklich gross ansieht. So bleibt die Zimmerseite
 * leicht, obwohl die Originale 1600-1920 px breit sind.
 */
const grossbilder = await Promise.all(
	bilder.map((bild) => getImage({ src: bild.src, width: 1600, format: 'webp', quality: 78 })),
);
---

<div
	class="zimmer-galerie"
	data-galerie
	data-name={name}
	data-texte={JSON.stringify(bedientexte)}
>
	<button
		type="button"
		class="group relative block w-full overflow-hidden rounded-3xl bg-cream-100"
		data-galerie-bild
		data-index="0"
		data-voll={grossbilder[0].src}
		aria-label={`${titelbild.alt} – ${t.galerie.groesser}`}
	>
		<Image
			src={titelbild.src}
			alt={titelbild.alt}
			widths={[480, 800, 1200]}
			sizes="(min-width: 1024px) 45vw, 100vw"
			format="webp"
			quality={72}
			loading="lazy"
			decoding="async"
			class="aspect-[4/3] w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
		/>
		<span
			class="pointer-events-none absolute bottom-4 right-4 rounded-full bg-ink-900/70 px-4 py-1.5 text-xs font-medium text-cream-50 backdrop-blur-sm"
		>
			{t.galerie.fotosAnsehen(bilder.length)}
		</span>
	</button>

	{weitere.length > 0 && (
		<div class="mt-3 grid grid-cols-3 gap-3 sm:grid-cols-4 lg:grid-cols-3">
			{weitere.map((bild, i) => (
				<button
					type="button"
					class="group overflow-hidden rounded-2xl bg-cream-100"
					data-galerie-bild
					data-index={i + 1}
					data-voll={grossbilder[i + 1].src}
					aria-label={`${bild.alt} – ${t.galerie.groesser}`}
				>
					<Image
						src={bild.src}
						alt={bild.alt}
						widths={[200, 400]}
						sizes="(min-width: 1024px) 15vw, 30vw"
						format="webp"
						quality={70}
						loading="lazy"
						decoding="async"
						class="aspect-square w-full object-cover transition-transform duration-500 group-hover:scale-105"
					/>
				</button>
			))}
		</div>
	)}
</div>

<script>
	// Die Lightbox ist seit 14.08.2026 GEMEINSAM fuer ZimmerGalerie und
	// PhotoGrid — Logik (inkl. Touch-Swipe, <dialog>, Vorladen) liegt in
	// src/scripts/galerie-lightbox.ts. Astro buendelt das Modul einmal pro
	// Seite, egal wie viele Galerien darauf stehen.
	import '../scripts/galerie-lightbox';
</script>
