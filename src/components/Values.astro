---
// Google-Bewertung + Kernwerte – Texte angelehnt an die Philosophie der Original-Website
// ("Wir stehen für Nachhaltigkeit, Regionalität, Qualität und Gastfreundschaft.").
// Icons: eigens gezeichnete, thematische Motive statt generischer Icon-Set-Symbole.
const values = [
	{
		title: 'Nachhaltigkeit',
		text: 'Wir legen besonders Wert auf einen achtsamen Umgang mit Lebensmitteln – mit kurzen Wegen und Respekt vor unserer Natur.',
		// Setzling mit Blättern und Erdlinie
		icon: `
			<path stroke-linecap="round" d="M12 21v-8" />
			<path stroke-linejoin="round" d="M12 13c.2-3.2-2.2-5.6-5.9-5.7-.1 3.4 2.3 5.7 5.9 5.7Z" />
			<path stroke-linejoin="round" d="M12 10.5c-.2-2.7 1.9-4.8 5-4.9.1 2.9-2 4.9-5 4.9Z" />
			<path stroke-linecap="round" d="M5.5 21h13" />
		`,
	},
	{
		title: 'Regionalität',
		text: 'Fleisch, Kartoffeln und viele weitere Produkte kommen von Händlern aus der Umgebung – wenn möglich direkt vom Erzeuger vor Ort.',
		// Getreideähre
		icon: `
			<path stroke-linecap="round" d="M12 21V4" />
			<path stroke-linejoin="round" d="M12 9C10.3 8.5 9.2 7.2 9 5.2c1.7.5 2.8 1.8 3 3.8Z" />
			<path stroke-linejoin="round" d="M12 9c1.7-.5 2.8-1.8 3-3.8-1.7.5-2.8 1.8-3 3.8Z" />
			<path stroke-linejoin="round" d="M12 13.5c-1.7-.5-2.8-1.8-3-3.8 1.7.5 2.8 1.8 3 3.8Z" />
			<path stroke-linejoin="round" d="M12 13.5c1.7-.5 2.8-1.8 3-3.8-1.7.5-2.8 1.8-3 3.8Z" />
			<path stroke-linejoin="round" d="M12 18c-1.7-.5-2.8-1.8-3-3.8 1.7.5 2.8 1.8 3 3.8Z" />
			<path stroke-linejoin="round" d="M12 18c1.7-.5 2.8-1.8 3-3.8-1.7.5-2.8 1.8-3 3.8Z" />
		`,
	},
	{
		title: 'Qualität',
		text: '„Wer gute Produkte verwendet, wird auch ein köstliches Essen zaubern" – genau nach diesem Motto kocht Frank jedes Gericht selbst.',
		// Kochmütze
		icon: `
			<path stroke-linecap="round" stroke-linejoin="round" d="M7.2 19.5v-5.6a4.3 4.3 0 0 1-1.9-7.9 4.3 4.3 0 0 1 2.9-1.5 4.7 4.7 0 0 1 7.6 0 4.3 4.3 0 0 1 2.9 1.5 4.3 4.3 0 0 1-1.9 7.9v5.6" />
			<path stroke-linecap="round" d="M7.2 19.5h9.6" />
			<path stroke-linecap="round" d="M10.4 16.4v-2.7M13.6 16.4v-2.7" />
		`,
	},
	{
		title: 'Gastfreundschaft',
		text: 'Zum perfekten Erlebnis gehören nicht nur gute Speisen, sondern auch freundliche Gastwirte – wir lernen unsere Gäste gern kennen.',
		// Haus mit Herz
		icon: `
			<path stroke-linecap="round" stroke-linejoin="round" d="m3.8 11.3 8.2-7 8.2 7" />
			<path stroke-linecap="round" stroke-linejoin="round" d="M6 9.5v10h12v-10" />
			<path stroke-linejoin="round" d="M12 16.8l-2.2-2.1a1.7 1.7 0 0 1 2.2-2.5 1.7 1.7 0 0 1 2.2 2.5Z" />
		`,
	},
];
---

<section class="border-b border-ink-900/5 bg-cream-50">
	<div class="mx-auto max-w-6xl px-6 py-20">
		<div class="flex flex-col items-stretch justify-center gap-8 sm:flex-row sm:gap-14">
			<div class="flex flex-col items-center text-center">
				<span class="flex h-8 items-center text-orange-500" aria-hidden="true">
					{Array.from({ length: 5 }).map(() => (
						<svg viewBox="0 0 20 20" fill="currentColor" class="h-6 w-6">
							<path d="M10 1.5l2.59 5.25 5.79.84-4.19 4.09.99 5.77L10 14.9l-5.18 2.55.99-5.77L1.62 7.6l5.79-.84L10 1.5z" />
						</svg>
					))}
				</span>
				<p class="mt-4 font-akzent text-3xl font-semibold text-ink-900 md:text-4xl">
					4,9 von 5
				</p>
				<p class="mt-1 text-sm uppercase tracking-[0.3em] text-orange-600">
					Google-Bewertungen
				</p>
			</div>

			<div class="hidden w-px self-stretch bg-ink-900/10 sm:block"></div>

			<div class="flex flex-col items-center text-center">
				<span class="flex h-8 items-center" aria-hidden="true">
					<span class="flex h-8 items-center rounded-md rounded-bl-none bg-[#003580] px-2.5 font-akzent text-lg font-bold text-white">
						9,2
					</span>
				</span>
				<p class="mt-4 font-akzent text-3xl font-semibold text-ink-900 md:text-4xl">
					9,2 von 10
				</p>
				<p class="mt-1 text-sm uppercase tracking-[0.3em] text-orange-600">
					Booking.com
				</p>
			</div>
		</div>

		<div class="mt-16 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
			{values.map((value) => (
				<div class="group flex flex-col items-center text-center">
					<svg
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.5"
						class="h-12 w-12 text-orange-600 transition-transform duration-300 group-hover:-translate-y-1 group-hover:scale-110"
						aria-hidden="true"
						set:html={value.icon}
					/>
					<h3 class="mt-5 font-akzent text-xl font-semibold text-ink-900">{value.title}</h3>
					<p class="mt-2 text-sm leading-relaxed text-ink-700/75">{value.text}</p>
				</div>
			))}
		</div>
	</div>
</section>
