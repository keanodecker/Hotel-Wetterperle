---
import { Image } from 'astro:assets';
import hero from '../assets/extracted/hero.jpg';
import logoMark from '../assets/extracted/logo-mark.png';
import { chefplatzUrl } from '../data/nav';
import { ausUrl, pfad } from '../i18n/ui';

const { sprache, t } = ausUrl(Astro.url);
---

<section class="relative flex h-[92vh] min-h-[640px] w-full items-center justify-center overflow-hidden">
	<div class="absolute inset-0">
		<Image
			src={hero}
			alt={t.hero.bildAlt}
			class="animate-kenburns h-full w-full object-cover"
			widths={[640, 1080, 1600, 2000]}
			sizes="100vw"
			priority
		/>
		<div class="absolute inset-0 bg-gradient-to-b from-ink-900/55 via-ink-900/35 to-ink-900/70"></div>
	</div>

	<div class="relative z-10 mx-auto flex max-w-3xl flex-col items-center px-6 text-center">
		<Image
			src={logoMark}
			alt=""
			width={360}
			height={414}
			format="png"
			class="animate-fade-in h-28 w-auto md:h-32"
			style="opacity: 0; filter: drop-shadow(0.5px 0 0 rgba(255,255,255,0.8)) drop-shadow(-0.5px 0 0 rgba(255,255,255,0.8)) drop-shadow(0 0.5px 0 rgba(255,255,255,0.8)) drop-shadow(0 -0.5px 0 rgba(255,255,255,0.8)) drop-shadow(0 8px 10px rgba(0,0,0,0.3));"
		/>

		<h1 class="animate-fade-in mt-5 flex flex-col items-center" style="animation-delay: 0.25s; opacity: 0;">
			<span class="text-sm font-semibold uppercase tracking-[0.45em] text-cream-100/90 md:text-base">
				{t.hero.kicker}
			</span>
			<span class="mt-1 font-akzent text-4xl font-bold text-cream-50 drop-shadow-md md:text-6xl">
				WetteraPerle
			</span>
		</h1>

		<p
			class="animate-fade-up mt-10 max-w-xl text-lg leading-relaxed text-cream-100/90 md:mt-12"
			style="animation-delay: 0.6s; opacity: 0;"
		>
			{t.hero.claim}
		</p>

		<div
			class="animate-fade-up mt-8 flex flex-wrap items-center justify-center gap-6 sm:gap-10"
			style="animation-delay: 0.85s; opacity: 0;"
		>
			<a
				href={chefplatzUrl}
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex min-w-48 items-center justify-center rounded-full bg-orange-500 px-8 py-3.5 text-sm font-semibold text-cream-50 shadow-lg transition-all duration-300 hover:-translate-y-0.5 hover:bg-orange-600 hover:shadow-xl"
			>
				{t.allgemein.tischReservieren}
			</a>
			<a
				href={pfad(sprache, '/hotel')}
				class="inline-flex min-w-48 items-center justify-center rounded-full border border-cream-50/50 px-8 py-3.5 text-sm font-semibold text-cream-50 transition-all duration-300 hover:-translate-y-0.5 hover:border-cream-50 hover:bg-cream-50/10"
			>
				{t.allgemein.hotelBuchen}
			</a>
		</div>
	</div>
</section>
