---
interface Props {
	kicker: string;
	title: string;
	description?: string;
}

const { kicker, title, description } = Astro.props;
---

<section class="bg-ink-900">
	<div class="mx-auto max-w-6xl px-6 py-20">
		<p class="font-serif text-sm uppercase tracking-[0.3em] text-orange-400">{kicker}</p>
		<h1 class="mt-3 font-serif text-4xl font-semibold text-cream-50 md:text-5xl">{title}</h1>
		{description && <p class="mt-4 max-w-2xl leading-relaxed text-cream-100/80">{description}</p>}
	</div>
</section>
