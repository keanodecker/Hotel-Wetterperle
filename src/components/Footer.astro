---
import { Image } from 'astro:assets';
import logo from '../assets/extracted/logo.png';
import mcLogo from '../assets/mc-logo-white.png';
import { footerNavItems, contact } from '../data/nav';
import { openingHours } from '../data/hours';

const year = new Date().getFullYear();
---

<footer class="bg-ink-900 text-cream-100">
	<div class="mx-auto grid max-w-6xl gap-12 px-6 py-16 md:grid-cols-4">
		<div class="md:col-span-1">
			<Image
				src={logo}
				alt="Landgasthof Wetteraperle"
				width={360}
				height={151}
				class="h-14 w-auto brightness-0 invert"
			/>
			<p class="mt-4 text-sm leading-relaxed text-cream-100/70">
				Gemütlichkeit, Ruhe und Genuss zwischen Feldern und Wäldern des Thüringer
				Schiefergebirges.
			</p>
		</div>

		<div>
			<p class="font-akzent text-sm font-semibold uppercase tracking-wider text-orange-400">Kontakt</p>
			<ul class="mt-4 space-y-2 text-sm text-cream-100/80">
				<li>{contact.street}</li>
				<li>{contact.zipCity}</li>
				<li><a href={contact.phoneHref} class="hover:text-orange-400">{contact.phoneDisplay}</a></li>
				<li><a href={`mailto:${contact.email}`} class="hover:text-orange-400">{contact.email}</a></li>
			</ul>
		</div>

		<div>
			<p class="font-akzent text-sm font-semibold uppercase tracking-wider text-orange-400">Öffnungszeiten</p>
			<ul class="mt-4 space-y-2 text-sm text-cream-100/80">
				{openingHours.map((entry) => (
					<li class="flex justify-between gap-4">
						<span>{entry.label}</span>
						<span class="text-right text-cream-100/60">
							{entry.ranges ? entry.ranges.join(' · ') : 'Ruhetag'}
						</span>
					</li>
				))}
			</ul>
		</div>

		<div>
			<p class="font-akzent text-sm font-semibold uppercase tracking-wider text-orange-400">Navigation</p>
			<ul class="mt-4 space-y-2 text-sm text-cream-100/80">
				{footerNavItems.map((item) => (
					<li><a href={item.href} class="hover:text-orange-400">{item.label}</a></li>
				))}
			</ul>
		</div>
	</div>

	<div class="flex flex-col items-center justify-between gap-4 border-t border-cream-100/10 px-6 py-5 text-center text-xs text-cream-100/60 sm:flex-row">
		<button
			type="button"
			aria-label="Switch to English"
			class="inline-flex items-center gap-2 rounded-full border border-cream-100/15 px-3 py-1.5 text-cream-100/80 transition-colors hover:border-cream-100/40 hover:text-cream-100"
		>
			<svg viewBox="0 0 60 30" class="h-4 w-auto rounded-sm" aria-hidden="true">
				<clipPath id="uk-flag-clip">
					<path d="M0,0 v30 h60 v-30 z" />
				</clipPath>
				<g clip-path="url(#uk-flag-clip)">
					<path d="M0,0 v30 h60 v-30 z" fill="#012169" />
					<path d="M0,0 L60,30 M60,0 L0,30" stroke="#fff" stroke-width="6" />
					<path d="M0,0 L60,30 M60,0 L0,30" stroke="#C8102E" stroke-width="4" />
					<path d="M30,0 v30 M0,15 h60" stroke="#fff" stroke-width="10" />
					<path d="M30,0 v30 M0,15 h60" stroke="#C8102E" stroke-width="6" />
				</g>
			</svg>
			English
		</button>

		<span>© {year} Landgasthof Wetteraperle. Alle Rechte vorbehalten.</span>
		<a
			href="https://www.media-castle.com"
			target="_blank"
			rel="noopener noreferrer"
			class="group inline-flex items-center gap-2.5 no-underline"
		>
			<Image src={mcLogo} alt="Media Castle" width={96} height={96} class="h-7 w-7" />
			<span class="flex flex-col items-start leading-tight">
				<span class="text-[9px] font-normal uppercase tracking-[0.25em] text-cream-100/50">
					Visualized by
				</span>
				<span class="text-sm font-semibold text-cream-100 transition-colors group-hover:text-orange-400">
					media castle
				</span>
			</span>
		</a>
	</div>
</footer>
