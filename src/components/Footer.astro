---
const year = new Date().getFullYear();
---

<footer class="bg-forest-900 text-cream-100">
	<div class="mx-auto grid max-w-6xl gap-10 px-6 py-14 md:grid-cols-3">
		<div>
			<p class="font-serif text-lg font-semibold text-cream-50">Hotel Wetterperle</p>
			<p class="mt-3 text-sm leading-relaxed text-forest-100">
				Ihr Rückzugsort zwischen Bergen und Himmel – persönliche Gastfreundschaft,
				ruhige Zimmer und Genuss aus der Region.
			</p>
		</div>

		<div>
			<p class="font-serif text-sm font-semibold uppercase tracking-wider text-gold-400">Kontakt</p>
			<ul class="mt-3 space-y-2 text-sm text-forest-100">
				<li>Wetterperlenweg 12, 87534 Bergstetten</li>
				<li>+49 (0) 8321 123 456</li>
				<li>info@hotel-wetterperle.de</li>
			</ul>
		</div>

		<div>
			<p class="font-serif text-sm font-semibold uppercase tracking-wider text-gold-400">Navigation</p>
			<ul class="mt-3 space-y-2 text-sm text-forest-100">
				<li><a href="/zimmer" class="hover:text-gold-400">Zimmer</a></li>
				<li><a href="/ueber-uns" class="hover:text-gold-400">Über uns</a></li>
				<li><a href="/galerie" class="hover:text-gold-400">Galerie</a></li>
				<li><a href="/kontakt" class="hover:text-gold-400">Kontakt</a></li>
			</ul>
		</div>
	</div>

	<div class="border-t border-forest-700 px-6 py-5 text-center text-xs text-forest-100">
		© {year} Hotel Wetterperle. Alle Rechte vorbehalten.
	</div>
</footer>
