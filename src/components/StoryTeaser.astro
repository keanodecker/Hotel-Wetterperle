---
import { Image } from 'astro:assets';
import owners from '../assets/extracted/owners.jpg';
---

<section class="bg-cream-100/60">
	<div class="mx-auto grid max-w-6xl gap-12 px-6 py-24 md:grid-cols-2 md:items-center">
		<div class="order-2 md:order-1">
			<p class="font-serif text-sm uppercase tracking-[0.3em] text-orange-600">Über uns</p>
			<h2 class="mt-3 font-serif text-3xl font-semibold text-ink-900 md:text-4xl">
				Frank &amp; Nadine Gröters
			</h2>
			<p class="mt-4 leading-relaxed text-ink-700/80">
				Seit 2018 führen Frank und Nadine Gröters die Wetteraperle mit Erfahrung aus
				Berlin und vom Tegernsee – und haben dem traditionsreichen Haus neuen Glanz
				verliehen. Frank, gelernter Koch mit über 30 Jahren Erfahrung, bereitet jedes
				Gericht persönlich zu.
			</p>
			<a
				href="/ueber-uns"
				class="mt-6 inline-block rounded-full border border-ink-900 px-6 py-3 text-sm font-semibold text-ink-900 transition-colors hover:bg-ink-900 hover:text-cream-50"
			>
				Unsere Geschichte
			</a>
		</div>
		<div class="order-1 flex justify-center md:order-2">
			<Image
				src={owners}
				alt="Frank und Nadine Gröters"
				class="h-72 w-72 rounded-full object-cover shadow-xl ring-8 ring-white"
			/>
		</div>
	</div>
</section>
