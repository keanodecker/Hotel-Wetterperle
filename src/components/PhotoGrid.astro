---
import { Image } from 'astro:assets';

interface GalleryImage {
	src: ImageMetadata;
	alt: string;
	caption?: string;
}

interface Props {
	images: GalleryImage[];
}

const { images } = Astro.props;
---

<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
	{images.map((img) => (
		<figure class="group overflow-hidden rounded-2xl">
			<Image
				src={img.src}
				alt={img.alt}
				class="h-64 w-full object-cover transition-transform duration-700 group-hover:scale-105"
			/>
			{img.caption && (
				<figcaption class="mt-2 text-xs text-ink-700/60">{img.caption}</figcaption>
			)}
		</figure>
	))}
</div>
