---
import { Image } from 'astro:assets';
import { rooms } from '../data/rooms';
import { contact } from '../data/nav';
import { ausUrl, preis } from '../i18n/ui';

const { sprache, t } = ausUrl(Astro.url);
const zimmer = rooms(sprache);

/*
 * Buchung laeuft ueber Smoobu, den Channel-Manager des Hauses (dort haengt auch
 * Booking.com dran). Smoobu bindet sein Buchungssystem NICHT als statischen
 * <iframe src=…> ein, sondern ueber ein eigenes Skript: das holt per XHR erst
 * JSON von login.smoobu.com und setzt den iFrame dann selbst in den Container.
 * Deshalb steht unten ein leeres <div> und kein iframe-Tag.
 *
 * ▼▼▼ DIESE EINE ZEILE AUSTAUSCHEN, sobald die Adresse aus Smoobu vorliegt ▼▼▼
 *
 * Wo sie herkommt:
 *   Smoobu (login.smoobu.com) → Einstellungen → "In Webseite integrieren"
 *   → Reiter BUCHUNGSSYSTEM. Dort steht ein fertiger Schnipsel; darin steckt
 *   in BookingToolIframe.initialize({ url: "…" }) genau diese Adresse.
 *   Nur sie hier eintragen, mit https:// beginnend.
 *
 * NICHT das ebenfalls angebotene "Kalender-Widget" nehmen: das zeigt nur belegte
 * Tage an und nimmt keine Buchungen entgegen - damit haetten wir die Attrappe
 * nur ausgetauscht.
 *
 * Voraussetzung in Smoobu: die Unterkunft ist mit Zimmern, Preisen und
 * Verfuegbarkeiten angelegt. Vorher erzeugt Smoobu keinen Buchungs-iFrame.
 *
 * Solange hier der Platzhalter steht, zeigt die Seite die Direktbuchung
 * (Telefon + E-Mail) statt eines leeren Rahmens.
 */
const SMOOBU_BUCHUNG_URL: string = 'https://login.smoobu.com/de/booking-tool/iframe/86259';

const smoobuBereit = SMOOBU_BUCHUNG_URL.startsWith('https://');

/*
 * WEG B, falls der iFrame an Third-Party-Cookies scheitert (noch nicht gebaut,
 * bewusst nur notiert): dann statt des eingebetteten Buchungssystems ein Link
 * auf booking.smoobu.com in einem neuen Tab - dort ist es keine Cross-Site-
 * Situation mehr.
 * Gemessen wurde: Smoobu setzt PHPSESSID8 ohne SameSite=None, ohne Secure und
 * ohne Partitioned; ein solches Cookie wird im Cross-Site-iFrame nicht
 * mitgeschickt, Safari blockt ohnehin. Ob es real bricht, ist NICHT bestaetigt
 * - ein Safari-Test auf der echten Domain ist vor Go-Live Pflicht.
 */
---

<div class="rounded-3xl border border-ink-900/10 bg-white p-6 shadow-sm md:p-10" id="booking-widget">
	{/* Zimmeruebersicht - reine Darstellung, die Auswahl trifft der Gast im Buchungssystem. */}
	<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
		{zimmer.map((room) => (
			<div class="flex flex-col overflow-hidden rounded-2xl border-2 border-ink-900/10">
				<div class="h-36 w-full overflow-hidden">
					<Image
						src={room.gallery[0].src}
						alt={room.gallery[0].alt}
						width={480}
						height={288}
						format="webp"
						quality={70}
						loading="lazy"
						decoding="async"
						class="h-full w-full object-cover"
					/>
				</div>
				<div class="flex flex-1 flex-col gap-2 p-5">
					<span class="font-akzent text-lg font-semibold text-ink-900">{room.name}</span>
					{room.size && <span class="text-xs text-ink-700/60">{room.size}</span>}
					<span class="text-sm text-ink-700/70">
						{room.maxGuests === 1 ? t.buchung.bisPerson : t.buchung.bisPersonen(room.maxGuests)}
					</span>
					<ul class="mt-1 space-y-1 text-xs text-ink-700/60">
						{room.features.map((feature) => (
							<li>· {feature}</li>
						))}
					</ul>
					{/* mt-auto drueckt Preis + Knopf an die Kartenunterkante — so stehen
					    alle Preise auf EINER Ebene, egal wie lang die Ausstattungsliste
					    darueber ist (KD-Ansage 12.08.2026). */}
					<div class="mt-auto border-t border-ink-900/10 pt-3">
						{room.pricePerNight === null ? (
							<span class="font-akzent text-lg font-semibold text-orange-600">
								{t.buchung.preisAufAnfrage}
							</span>
						) : (
							<span class="font-akzent text-xl font-semibold text-orange-600">
								{t.buchung.ab} {preis(sprache, room.pricePerNight)}
								<span class="text-xs font-normal text-ink-700/60">{t.buchung.proNacht}</span>
							</span>
						)}
						<button
							type="button"
							data-buchen={room.id}
							class="mt-3 w-full rounded-full bg-orange-500 px-5 py-2.5 text-sm font-semibold text-cream-50 transition-colors hover:bg-orange-600"
						>
							{t.buchung.buchen}
						</button>
					</div>
				</div>
			</div>
		))}
	</div>

	{smoobuBereit ? (
		<Fragment>
			{/*
			 * Hier haengt Smoobus Skript den Buchungs-iFrame hinein. Keine feste
			 * Hoehe: das Skript bringt eine automatische Hoehenanpassung mit.
			 */}
			<div id="smoobu-buchung" class="mt-8"></div>

			{/*
			 * DRITTANBIETER-JS - relevant fuer die Datenschutzerklaerung:
			 * BookingToolIframe.js laedt zusaetzlich iframe-resizer 3.5.16 von
			 * cdnjs.cloudflare.com (Stand Januar 2018) und jQuery, falls keins da
			 * ist - auf dieser Seite ist keins da, es kommt also mit. Der erste
			 * Schritt ist ein XHR an login.smoobu.com, erst danach entsteht der
			 * iFrame.
			 *
			 * is:inline ist PFLICHT: ohne das buendelt Astro die beiden Skripte,
			 * der initialize-Aufruf laeuft dann vor der geladenen Datei und es
			 * erscheint gar nichts - was wie ein Smoobu-Defekt aussieht.
			 */}
			<script is:inline src="https://login.smoobu.com/js/Settings/BookingToolIframe.js"></script>
			<script
				is:inline
				set:html={`BookingToolIframe.initialize({ url: "${SMOOBU_BUCHUNG_URL}", baseUrl: "https://login.smoobu.com", target: "#smoobu-buchung" });`}
			/>

			<noscript>
				<div class="mt-8 rounded-2xl bg-ink-900 p-8 text-cream-50">
					<p class="leading-relaxed text-cream-100/85">
						{t.buchung.ohneJs}
					</p>
					<div class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
						<a
							href={contact.phoneHref}
							class="rounded-full bg-orange-500 px-7 py-3 text-center text-sm font-semibold text-cream-50 transition-colors hover:bg-orange-600"
						>
							{contact.phoneDisplay}
						</a>
						<a
							href={`mailto:${contact.email}`}
							class="rounded-full border border-cream-50/35 px-7 py-3 text-center text-sm font-semibold text-cream-50 transition-colors hover:bg-cream-50/10"
						>
							{contact.email}
						</a>
					</div>
				</div>
			</noscript>
		</Fragment>
	) : (
		<div class="mt-8 rounded-2xl bg-ink-900 p-8 text-cream-50">
			<p class="leading-relaxed text-cream-100/85">
				{t.buchung.direkt}
			</p>
			<div class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
				<button
					type="button"
					data-buchen
					class="rounded-full bg-orange-500 px-7 py-3 text-center text-sm font-semibold text-cream-50 transition-colors hover:bg-orange-600"
				>
					{t.buchung.absenden}
				</button>
				<a
					href={contact.phoneHref}
					class="rounded-full border border-cream-50/35 px-7 py-3 text-center text-sm font-semibold text-cream-50 transition-colors hover:bg-cream-50/10"
				>
					{contact.phoneDisplay}
				</a>
				<a
					href={`mailto:${contact.email}`}
					class="rounded-full border border-cream-50/35 px-7 py-3 text-center text-sm font-semibold text-cream-50 transition-colors hover:bg-cream-50/10"
				>
					{contact.email}
				</a>
			</div>
		</div>
	)}
</div>
