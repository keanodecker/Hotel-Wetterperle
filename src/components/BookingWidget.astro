---
import { Image } from 'astro:assets';
import { rooms } from '../data/rooms';
---

<div class="rounded-3xl border border-ink-900/10 bg-white p-6 shadow-sm md:p-10" id="booking-widget">
	<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
		{rooms.map((room, index) => (
			<label class="relative flex cursor-pointer flex-col overflow-hidden rounded-2xl border-2 border-ink-900/10 transition-colors has-[:checked]:border-orange-500 has-[:checked]:bg-orange-50">
				<div class="h-36 w-full overflow-hidden">
					<Image
						src={room.image}
						alt={room.imageAlt}
						width={480}
						height={288}
						class="h-full w-full object-cover"
					/>
				</div>
				<div class="flex flex-1 flex-col gap-2 p-5">
					<input
						type="radio"
						name="room"
						value={room.id}
						checked={index === 1}
						data-name={room.name}
						data-price={room.pricePerNight}
						class="absolute right-4 top-4 h-4 w-4 accent-orange-500"
					/>
					<span class="pr-6 font-serif text-lg font-semibold text-ink-900">{room.name}</span>
					{room.size && <span class="text-xs text-ink-700/60">{room.size}</span>}
					<span class="text-sm text-ink-700/70">
						bis {room.maxGuests} {room.maxGuests === 1 ? 'Person' : 'Personen'}
					</span>
					<ul class="mt-1 space-y-1 text-xs text-ink-700/60">
						{room.features.map((feature) => (
							<li>· {feature}</li>
						))}
					</ul>
					<span class="mt-2 font-serif text-xl font-semibold text-orange-600">
						ab {room.pricePerNight} €<span class="text-xs font-normal text-ink-700/60"> / Nacht</span>
					</span>
				</div>
			</label>
		))}
	</div>

	<div class="mt-8 grid gap-4 sm:grid-cols-3">
		<div>
			<label for="anreise" class="text-sm font-medium text-ink-900">Anreise</label>
			<input
				type="date"
				id="anreise"
				class="mt-1 w-full rounded-lg border border-ink-900/15 px-4 py-2.5 text-sm focus:border-orange-500 focus:outline-none"
			/>
		</div>
		<div>
			<label for="abreise" class="text-sm font-medium text-ink-900">Abreise</label>
			<input
				type="date"
				id="abreise"
				class="mt-1 w-full rounded-lg border border-ink-900/15 px-4 py-2.5 text-sm focus:border-orange-500 focus:outline-none"
			/>
		</div>
		<div>
			<label for="gaeste" class="text-sm font-medium text-ink-900">Gäste</label>
			<select
				id="gaeste"
				class="mt-1 w-full rounded-lg border border-ink-900/15 px-4 py-2.5 text-sm focus:border-orange-500 focus:outline-none"
			>
				<option value="1">1 Person</option>
				<option value="2" selected>2 Personen</option>
				<option value="3">3 Personen</option>
			</select>
		</div>
	</div>

	<p id="booking-error" class="mt-4 hidden text-sm font-medium text-red-600"></p>

	<button
		id="check-availability"
		type="button"
		class="mt-6 w-full rounded-full bg-orange-500 px-7 py-3.5 text-sm font-semibold text-cream-50 transition-colors hover:bg-orange-600 disabled:opacity-60 sm:w-auto"
	>
		Verfügbarkeit prüfen
	</button>

	<div id="booking-result" class="mt-8 hidden rounded-2xl bg-ink-900 p-8 text-cream-50">
		<p class="font-serif text-sm uppercase tracking-[0.3em] text-orange-400">Verfügbar</p>
		<h3 class="mt-2 font-serif text-2xl font-semibold" id="result-room"></h3>
		<dl class="mt-4 space-y-2 text-sm text-cream-100/80">
			<div class="flex justify-between">
				<dt>Zeitraum</dt>
				<dd id="result-dates"></dd>
			</div>
			<div class="flex justify-between">
				<dt>Nächte</dt>
				<dd id="result-nights"></dd>
			</div>
			<div class="flex justify-between">
				<dt>Preis pro Nacht</dt>
				<dd id="result-price"></dd>
			</div>
			<div class="flex justify-between border-t border-cream-50/20 pt-2 font-semibold text-cream-50">
				<dt>Gesamtpreis</dt>
				<dd id="result-total"></dd>
			</div>
		</dl>
		<a
			href="/kontakt"
			class="mt-6 inline-block rounded-full bg-orange-500 px-7 py-3 text-sm font-semibold text-cream-50 transition-colors hover:bg-orange-600"
		>
			Jetzt anfragen
		</a>
	</div>

	<p class="mt-6 text-xs text-ink-700/50">
		Hinweis: Diese Verfügbarkeitsprüfung ist eine Demo-Funktion zur Veranschaulichung und
		noch nicht mit einem echten Buchungssystem verbunden.
	</p>
</div>

<script>
	function formatDate(value: string) {
		return new Date(value).toLocaleDateString('de-DE', { day: '2-digit', month: '2-digit', year: 'numeric' });
	}

	const widget = document.getElementById('booking-widget');

	if (widget) {
		const checkinInput = document.getElementById('anreise') as HTMLInputElement;
		const checkoutInput = document.getElementById('abreise') as HTMLInputElement;
		const button = document.getElementById('check-availability') as HTMLButtonElement;
		const errorEl = document.getElementById('booking-error') as HTMLParagraphElement;
		const resultEl = document.getElementById('booking-result') as HTMLDivElement;

		const today = new Date().toISOString().split('T')[0];
		checkinInput.min = today;
		checkoutInput.min = today;

		button.addEventListener('click', () => {
			errorEl.classList.add('hidden');
			resultEl.classList.add('hidden');

			const selectedRoom = widget.querySelector<HTMLInputElement>('input[name="room"]:checked');
			const checkin = checkinInput.value;
			const checkout = checkoutInput.value;

			if (!selectedRoom || !checkin || !checkout) {
				errorEl.textContent = 'Bitte Zimmer, Anreise- und Abreisedatum auswählen.';
				errorEl.classList.remove('hidden');
				return;
			}

			const nights = Math.round(
				(new Date(checkout).getTime() - new Date(checkin).getTime()) / 86_400_000,
			);

			if (nights <= 0) {
				errorEl.textContent = 'Die Abreise muss nach der Anreise liegen.';
				errorEl.classList.remove('hidden');
				return;
			}

			button.disabled = true;
			button.textContent = 'Verfügbarkeit wird geprüft…';

			setTimeout(() => {
				const price = Number(selectedRoom.dataset.price);
				const total = price * nights;

				document.getElementById('result-room')!.textContent = String(selectedRoom.dataset.name);
				document.getElementById('result-dates')!.textContent = `${formatDate(checkin)} – ${formatDate(checkout)}`;
				document.getElementById('result-nights')!.textContent = `${nights} ${nights === 1 ? 'Nacht' : 'Nächte'}`;
				document.getElementById('result-price')!.textContent = `${price} €`;
				document.getElementById('result-total')!.textContent = `${total} €`;

				resultEl.classList.remove('hidden');
				resultEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

				button.disabled = false;
				button.textContent = 'Verfügbarkeit prüfen';
			}, 700);
		});
	}
</script>
