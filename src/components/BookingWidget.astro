---
import { Image } from 'astro:assets';
import { rooms } from '../data/rooms';
import { contact } from '../data/nav';
import { ausUrl, preis } from '../i18n/ui';

const { sprache, t } = ausUrl(Astro.url);
const zimmer = rooms(sprache);

/*
 * Zimmer-Grid mit zwei Wegen je Zimmer (KD-Entscheidung 14.08.2026 12:04):
 *  · „Buchen"   → BuchungsModal im BUCHEN-Modus → /api/zimmer-buchen → echte,
 *    verbindliche Smoobu-Buchung zum WEBSITE-Preis (inkl. Fruehstueck +
 *    Kulturfoerderabgabe).
 *  · „Anfragen" → BuchungsModal im ANFRAGE-Modus → unverbindliche Mail ans
 *    Haus ueber /api/kontakt (Resend).
 *
 * Der Smoobu-Buchungs-iFrame, der hier bis zum 14.08.2026 unter dem Grid hing,
 * ist auf KD-Ansage RAUS („dann haben wir nicht noch dieses Smoobu Design auf
 * der Website"). Nebeneffekt, den die Datenschutzerklaerung freut: die Seite
 * laedt damit auch kein BookingToolIframe.js mehr nach — das zog jQuery und
 * iframe-resizer 3.5.16 von cdnjs.cloudflare.com (US-CDN) hinterher.
 * Der API-Zugang fuer die eigene Buchungsstrecke steckt in lib/smoobu.ts.
 */
---

<div class="rounded-3xl border border-ink-900/10 bg-white p-6 shadow-sm md:p-10" id="booking-widget">
	{/* Zimmeruebersicht - reine Darstellung, die Auswahl trifft der Gast im Buchungssystem. */}
	<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
		{zimmer.map((room) => (
			<div class="flex flex-col overflow-hidden rounded-2xl border-2 border-ink-900/10">
				<div class="h-36 w-full overflow-hidden">
					<Image
						src={room.gallery[0].src}
						alt={room.gallery[0].alt}
						width={480}
						height={288}
						format="webp"
						quality={70}
						loading="lazy"
						decoding="async"
						class="h-full w-full object-cover"
					/>
				</div>
				<div class="flex flex-1 flex-col gap-2 p-5">
					<span class="font-akzent text-lg font-semibold text-ink-900">{room.name}</span>
					{room.size && <span class="text-xs text-ink-700/60">{room.size}</span>}
					<span class="text-sm text-ink-700/70">
						{room.maxGuests === 1 ? t.buchung.bisPerson : t.buchung.bisPersonen(room.maxGuests)}
					</span>
					<ul class="mt-1 space-y-1 text-xs text-ink-700/60">
						{room.features.map((feature) => (
							<li>· {feature}</li>
						))}
					</ul>
					{/* mt-auto drueckt Preis + Knopf an die Kartenunterkante — so stehen
					    alle Preise auf EINER Ebene, egal wie lang die Ausstattungsliste
					    darueber ist (KD-Ansage 12.08.2026). */}
					<div class="mt-auto border-t border-ink-900/10 pt-3">
						{room.pricePerNight === null ? (
							<span class="font-akzent text-lg font-semibold text-orange-600">
								{t.buchung.preisAufAnfrage}
							</span>
						) : (
							<span class="font-akzent text-xl font-semibold text-orange-600">
								{t.buchung.ab} {preis(sprache, room.pricePerNight)}
								<span class="text-xs font-normal text-ink-700/60">{t.buchung.proNacht}</span>
							</span>
						)}
						{/* Fruehstueck + Kulturfoerderabgabe stehen als Punkt in der
						    Ausstattungsliste oben (KD 14.08.2026 ~12:20: Badge raus,
						    "schreib das einfach in diese Liste rein"). Die Personen-
						    Staffel zeigt erst der Dialog, sobald 3+ Gaeste gewaehlt sind. */}
						{/* Primaer die verbindliche Buchung, sekundaer die unverbindliche
						    Anfrage — beide oeffnen den Dialog im jeweiligen Modus. */}
						<button
							type="button"
							data-buchen={room.id}
							class="mt-3 w-full rounded-full bg-orange-500 px-5 py-2.5 text-sm font-semibold text-cream-50 transition-colors hover:bg-orange-600"
						>
							{t.buchung.knopfBuchen}
						</button>
						<button
							type="button"
							data-anfragen={room.id}
							class="mt-2 w-full rounded-full border border-ink-900/15 px-5 py-2.5 text-sm font-semibold text-ink-900 transition-colors hover:border-orange-500 hover:text-orange-600"
						>
							{t.buchung.knopfAnfragen}
						</button>
					</div>
				</div>
			</div>
		))}
	</div>

	{/* Dialog und Versand laufen im Browser — ohne JavaScript waeren die Knoepfe
	    oben tot. Dieser Hinweis ersetzt den frueheren noscript-Block des
	    Smoobu-iframes: Telefon und E-Mail funktionieren immer. */}
	<noscript>
		<div class="mt-8 rounded-2xl bg-ink-900 p-8 text-cream-50">
			<p class="leading-relaxed text-cream-100/85">{t.buchung.ohneJs}</p>
			<div class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
				<a
					href={contact.phoneHref}
					class="rounded-full bg-orange-500 px-7 py-3 text-center text-sm font-semibold text-cream-50 transition-colors hover:bg-orange-600"
				>
					{contact.phoneDisplay}
				</a>
				<a
					href={`mailto:${contact.email}`}
					class="rounded-full border border-cream-50/35 px-7 py-3 text-center text-sm font-semibold text-cream-50 transition-colors hover:bg-cream-50/10"
				>
					{contact.email}
				</a>
			</div>
		</div>
	</noscript>
</div>
