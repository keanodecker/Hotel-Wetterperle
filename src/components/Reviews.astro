---
import { reviews } from '../data/reviews';
import RatingBadge from './RatingBadge.astro';
import { ausUrl } from '../i18n/ui';

/*
 * ⚠️ Die Bewertungstexte selbst bleiben in JEDER Sprachfassung DEUTSCH.
 * Es sind echte, woertlich uebernommene Google-Rezensionen von Gaesten -
 * eine Uebersetzung waere ein veraendertes Zitat. Uebersetzt werden nur die
 * Ueberschriften und die Bedienelemente drumherum.
 */
const { t } = ausUrl(Astro.url);
---

<section class="overflow-hidden bg-cream-100/60 py-24">
	<div class="mx-auto max-w-6xl px-6 text-center">
		<p class="font-akzent text-sm uppercase tracking-[0.3em] text-orange-600">{t.bewertungen.kicker}</p>
		<h2 class="mt-3 font-akzent text-3xl font-semibold text-ink-900 md:text-4xl">
			{t.bewertungen.titel}
		</h2>
		<div class="mt-5 flex justify-center">
			<RatingBadge />
		</div>
	</div>

	<div id="review-slider" class="mx-auto mt-14 max-w-3xl px-6" style="transition: max-width 700ms ease;">
		<div class="relative rounded-3xl border border-ink-900/10 bg-white px-8 py-12 shadow-sm md:px-16">
			<span
				class="pointer-events-none absolute -top-2 left-8 select-none font-akzent text-8xl leading-none text-orange-100 md:left-12"
				aria-hidden="true"
			>„</span>

			{/* touch-pan-y: vertikales Scrollen bleibt beim Browser, horizontales
			    Wischen blaettert die Bewertungen (KD 14.08.2026 12:35). */}
			<div id="review-viewport" class="relative touch-pan-y overflow-hidden" aria-live="polite">
				{reviews.map((review, index) => (
					<figure
						data-slide
						class:list={[
							'inset-x-0 top-0 flex flex-col items-center gap-6 text-center transition-opacity duration-700',
							index === 0 ? 'relative opacity-100' : 'absolute pointer-events-none opacity-0',
						]}
					>
						<div class="flex text-orange-500" aria-hidden="true">
							{Array.from({ length: review.rating }).map(() => (
								<svg viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5">
									<path d="M10 1.5l2.59 5.25 5.79.84-4.19 4.09.99 5.77L10 14.9l-5.18 2.55.99-5.77L1.62 7.6l5.79-.84L10 1.5z" />
								</svg>
							))}
						</div>
						<blockquote class="text-lg leading-relaxed text-ink-700/90 md:text-xl">
							{review.text}
						</blockquote>
						<figcaption class="flex items-center gap-3">
							<span class="flex h-10 w-10 items-center justify-center rounded-full bg-orange-500 font-akzent text-lg font-bold text-cream-50">
								{review.author.charAt(0)}
							</span>
							<span class="text-left">
								<span class="block text-sm font-semibold text-ink-900">{review.author}</span>
								<span class="block text-xs text-ink-700/60">{t.allgemein.googleBewertung}</span>
							</span>
						</figcaption>
					</figure>
				))}
			</div>

			<button
				type="button"
				data-prev
				aria-label={t.bewertungen.vorherige}
				class="absolute left-3 top-1/2 hidden h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border border-ink-900/10 bg-white text-ink-900 shadow-sm transition-colors hover:bg-orange-500 hover:text-cream-50 md:flex"
			>
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
				</svg>
			</button>
			<button
				type="button"
				data-next
				aria-label={t.bewertungen.naechste}
				class="absolute right-3 top-1/2 hidden h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border border-ink-900/10 bg-white text-ink-900 shadow-sm transition-colors hover:bg-orange-500 hover:text-cream-50 md:flex"
			>
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
				</svg>
			</button>
		</div>

		<div class="mt-8 flex items-center justify-center gap-2.5">
			{reviews.map((review, index) => (
				<button
					type="button"
					data-dot
					aria-label={t.bewertungen.punkt(index + 1, reviews.length)}
					class:list={[
						'h-2.5 rounded-full transition-all duration-300',
						index === 0 ? 'w-8 bg-orange-500' : 'w-2.5 bg-ink-900/15 hover:bg-ink-900/30',
					]}
				/>
			))}
		</div>
	</div>
</section>

<script>
	import { beiHorizontalemSwipe } from '../scripts/swipe';

	const sliderEl = document.getElementById('review-slider');

	if (sliderEl) {
		// Explizit als HTMLElement gebunden: das Narrowing aus dem if oben kam
		// in den Funktionen unten (measure/show sind Closures) nicht an —
		// daher stammten die neun "slider is possibly null"-Typfehler.
		const slider: HTMLElement = sliderEl;
		const viewport = document.getElementById('review-viewport')!;
		const slides = [...slider.querySelectorAll<HTMLElement>('[data-slide]')];
		const dots = [...slider.querySelectorAll<HTMLElement>('[data-dot]')];
		const INTERVAL = 6000;
		let current = 0;
		let timer: ReturnType<typeof setInterval> | undefined;

		// KD-Vorgabe 12.08.2026: Die Box behält IMMER dieselbe Höhe (bestimmt von
		// den kurzen Bewertungen). Eine lange Bewertung macht die Box nicht höher,
		// sondern BREITER. Dazu wird jede Bewertung bei mehreren Kandidaten-Breiten
		// vermessen und die schmalste Breite gewählt, bei der sie in die feste
		// Höhe passt. Auf schmalen Screens (kein Platz in die Breite) bleibt das
		// alte Verhalten: Höhe passt sich an.
		const BASE_WIDTH = 768; // = max-w-3xl
		const WIDTHS = [768, 960, 1152];
		const KURZE = 6; // Bewertung 1–6 bestimmen die feste Höhe
		let slideWidth: number[] = slides.map(() => BASE_WIDTH);
		let fixedMode = false;

		function measure() {
			const platz = document.documentElement.clientWidth;
			fixedMode = platz >= WIDTHS[1];
			slider.style.transition = 'none';

			if (!fixedMode) {
				slider.style.maxWidth = '';
				viewport.style.height = '';
				slides.forEach((s) => {
					s.style.height = '';
					s.classList.remove('justify-center');
				});
				slideWidth = slides.map(() => BASE_WIDTH);
				requestAnimationFrame(() => (slider.style.transition = 'max-width 700ms ease'));
				return;
			}

			viewport.style.height = '';
			slides.forEach((s) => (s.style.height = ''));

			const kandidaten = WIDTHS.filter((w) => w <= platz);
			const hoehen: number[][] = [];
			for (const w of kandidaten) {
				slider.style.maxWidth = w + 'px';
				void slider.offsetWidth;
				hoehen.push(slides.map((s) => s.offsetHeight));
			}

			const festeHoehe = Math.max(...hoehen[0].slice(0, KURZE));
			slideWidth = slides.map((_, i) => {
				for (let k = 0; k < kandidaten.length; k++) {
					if (hoehen[k][i] <= festeHoehe) return kandidaten[k];
				}
				return kandidaten[kandidaten.length - 1];
			});
			// Passt eine Bewertung selbst in der breitesten Stufe nicht, wächst die
			// feste Höhe minimal mit — sie bleibt trotzdem für ALLE gleich.
			const endHoehe = Math.max(
				festeHoehe,
				...slides.map((_, i) => hoehen[kandidaten.indexOf(slideWidth[i])][i]),
			);

			viewport.style.height = endHoehe + 'px';
			slides.forEach((s) => {
				s.style.height = '100%';
				s.classList.add('justify-center');
			});
			slider.style.maxWidth = slideWidth[current] + 'px';
			void slider.offsetWidth;
			slider.style.transition = 'max-width 700ms ease';
		}

		function show(index: number) {
			current = (index + slides.length) % slides.length;

			if (fixedMode) slider.style.maxWidth = slideWidth[current] + 'px';

			slides.forEach((slide, i) => {
				const active = i === current;
				slide.classList.toggle('relative', active);
				slide.classList.toggle('absolute', !active);
				slide.classList.toggle('opacity-100', active);
				slide.classList.toggle('opacity-0', !active);
				slide.classList.toggle('pointer-events-none', !active);
			});

			dots.forEach((dot, i) => {
				const active = i === current;
				dot.classList.toggle('w-8', active);
				dot.classList.toggle('bg-orange-500', active);
				dot.classList.toggle('w-2.5', !active);
				dot.classList.toggle('bg-ink-900/15', !active);
			});
		}

		function start() {
			stop();
			timer = setInterval(() => show(current + 1), INTERVAL);
		}

		function stop() {
			if (timer) clearInterval(timer);
		}

		slider.querySelector('[data-prev]')?.addEventListener('click', () => {
			show(current - 1);
			start();
		});
		slider.querySelector('[data-next]')?.addEventListener('click', () => {
			show(current + 1);
			start();
		});
		dots.forEach((dot, i) =>
			dot.addEventListener('click', () => {
				show(i);
				start();
			}),
		);

		slider.addEventListener('mouseenter', stop);
		slider.addEventListener('mouseleave', start);
		slider.addEventListener('focusin', stop);
		slider.addEventListener('focusout', start);

		// Wischen blaettert die Bewertungen (KD 14.08.2026) — NUR Touch: mit der
		// Maus wuerde die Geste mit dem Markieren des Bewertungstextes
		// kollidieren. Gemeinsame Logik aus swipe.ts (wie die Galerie-Lightbox).
		beiHorizontalemSwipe(
			viewport,
			(richtung) => {
				show(current + richtung);
				start();
			},
			{ nurTouch: true },
		);

		measure();
		// Webfonts ändern die Textmaße — nach dem Laden einmal neu vermessen.
		document.fonts?.ready.then(measure);
		let resizeTimer: ReturnType<typeof setTimeout> | undefined;
		window.addEventListener('resize', () => {
			clearTimeout(resizeTimer);
			resizeTimer = setTimeout(measure, 150);
		});

		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
		if (!reducedMotion.matches) start();
	}
</script>
