---
import { reviews } from '../data/reviews';
import RatingBadge from './RatingBadge.astro';

const track = [...reviews, ...reviews];
---

<section class="overflow-hidden bg-cream-100/60 py-24">
	<div class="mx-auto max-w-6xl px-6 text-center">
		<p class="font-serif text-sm uppercase tracking-[0.3em] text-orange-600">Das sagen unsere Gäste</p>
		<h2 class="mt-3 font-serif text-3xl font-semibold text-ink-900 md:text-4xl">
			Bewertungen aus erster Hand
		</h2>
		<div class="mt-5 flex justify-center">
			<RatingBadge />
		</div>
	</div>

	<div class="relative mt-14 overflow-x-auto md:overflow-hidden">
		<div class="marquee-track flex w-max animate-marquee gap-6 px-6">
			{track.map((review) => (
				<figure class="flex w-80 shrink-0 flex-col gap-4 rounded-2xl border border-ink-900/10 bg-white p-7 text-left shadow-sm">
					<div class="flex text-orange-500" aria-hidden="true">
						{Array.from({ length: review.rating }).map(() => (
							<svg viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4">
								<path
									d="M10 1.5l2.59 5.25 5.79.84-4.19 4.09.99 5.77L10 14.9l-5.18 2.55.99-5.77L1.62 7.6l5.79-.84L10 1.5z"
								></path>
							</svg>
						))}
					</div>
					<blockquote class="flex-1 text-sm leading-relaxed text-ink-700/90">"{review.text}"</blockquote>
					<figcaption class="text-sm font-semibold text-ink-900">{review.author}</figcaption>
				</figure>
			))}
		</div>
	</div>
</section>
