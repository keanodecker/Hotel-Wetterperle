---
import { Image } from 'astro:assets';
import restaurant from '../assets/gallery/restaurant/frank-restaurant-auswahl.jpg';
import hotel from '../assets/gallery/zimmer/frank-hotel-auswahl.jpg';
import events from '../assets/gallery/feiern/feiern-02.jpg';

// Texte 1:1 von der Original-Startseite (wetteraperle.de) übernommen.
const services = [
	{
		title: 'Restaurant',
		text: 'Unser Geheimnis sind frische und regionale Produkte. Wir paaren internationale Küche mit heimischen Spezialitäten. Wir wollen Sie mit lokalen und nicht-lokalen Gerichten überraschen.',
		href: '/restaurant',
		image: restaurant,
	},
	{
		title: 'Hotel',
		text: 'Unsere Wetteraperle befindet sich inmitten einer idyllischen Landschaft und wir bieten Ihnen Platz für Familien und Paare.',
		href: '/hotel',
		image: hotel,
	},
	{
		title: 'Feiern',
		text: 'Unser neuer Festsaal bietet Platz für große Feierlichkeiten. Wir übernehmen für Sie die Veranstaltung von Hochzeiten, Jugendweihen, Konfirmationen und Geburtstagen.',
		href: '/feiern',
		image: events,
	},
];
---

<section class="mx-auto max-w-6xl px-6 py-24">
	<div class="mb-14 max-w-3xl">
		<p class="font-akzent text-sm uppercase tracking-[0.3em] text-orange-600">Willkommen</p>
		<h2 class="mt-3 font-akzent text-3xl font-semibold text-ink-900 md:text-4xl">
			Dienstleistungen
		</h2>
		<p class="mt-4 leading-relaxed text-ink-700/80">
			Gemütlichkeit, Ruhe und Genuss – dafür stehen wir in der Wetteraperle und das
			geben wir auch an unsere Gäste weiter. Wir, Frank und Nadine Gröters, wollen die
			Wetteraperle in einem neuen Glanz erstrahlen lassen und die historischen Zeiten
			wieder zurück nach Raila bringen.
		</p>
		<p class="mt-3 leading-relaxed text-ink-700/80">
			In unserer Küche sorgen wir mit Frische, Qualität und Kreativität für neue
			Erfahrungen im Saale-Orla-Kreis. Lassen Sie sich von unseren Kochkünsten
			verzaubern. Als Gast in einem unserer Fremdenzimmer verwöhnen wir Sie mit
			Gelassenheit, einer ruhigen grünen Landidylle und einer einzigartigen
			Gastfreundschaft.
		</p>
	</div>

	<div class="grid gap-10 md:grid-cols-3">
		{services.map((service) => (
			<a
				href={service.href}
				class="group flex flex-col overflow-hidden rounded-3xl border border-ink-900/10 bg-white shadow-sm transition-all hover:-translate-y-1 hover:shadow-xl"
			>
				<div class="h-64 w-full overflow-hidden">
					<Image
						src={service.image}
						alt={service.title}
						class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
					/>
				</div>
				<div class="flex flex-1 flex-col gap-3 p-8">
					<h3 class="font-akzent text-2xl font-semibold text-ink-900">{service.title}</h3>
					<p class="text-sm leading-relaxed text-ink-700/80">{service.text}</p>
					<span class="mt-auto pt-3 text-sm font-semibold text-orange-600 group-hover:text-orange-500">
						Mehr erfahren →
					</span>
				</div>
			</a>
		))}
	</div>
</section>
