---
import { Image } from 'astro:assets';
import restaurant from '../assets/extracted/restaurant.jpg';
import hotel from '../assets/extracted/hotel.jpg';
import events from '../assets/extracted/events.jpg';

const services = [
	{
		title: 'Restaurant',
		text: 'Gehobene gutbürgerliche Küche mit regionalen und saisonalen Produkten – von Frank persönlich zubereitet, samt Biergarten am Teich.',
		href: '/restaurant',
		image: restaurant,
	},
	{
		title: 'Hotel',
		text: 'Helle, moderne Zimmer und Suiten für den Rückzug nach einem Tag im Schiefergebirge – inklusive Frühstück.',
		href: '/hotel',
		image: hotel,
	},
	{
		title: 'Feiern',
		text: 'Hochzeiten, Geburtstage und Familienfeste im Festsaal oder direkt am See – individuell geplant, ganz nach Ihrem Anlass.',
		href: '/feiern',
		image: events,
	},
];
---

<section class="mx-auto max-w-6xl px-6 py-24">
	<div class="mb-14 max-w-2xl">
		<p class="font-serif text-sm uppercase tracking-[0.3em] text-orange-600">Willkommen</p>
		<h2 class="mt-3 font-serif text-3xl font-semibold text-ink-900 md:text-4xl">
			Drei Gründe, uns zu besuchen
		</h2>
	</div>

	<div class="grid gap-10 md:grid-cols-3">
		{services.map((service) => (
			<a
				href={service.href}
				class="group flex flex-col overflow-hidden rounded-3xl border border-ink-900/10 bg-white shadow-sm transition-all hover:-translate-y-1 hover:shadow-xl"
			>
				<div class="h-64 w-full overflow-hidden">
					<Image
						src={service.image}
						alt={service.title}
						class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
					/>
				</div>
				<div class="flex flex-1 flex-col gap-3 p-8">
					<h3 class="font-serif text-2xl font-semibold text-ink-900">{service.title}</h3>
					<p class="text-sm leading-relaxed text-ink-700/80">{service.text}</p>
					<span class="mt-auto pt-3 text-sm font-semibold text-orange-600 group-hover:text-orange-500">
						Mehr erfahren →
					</span>
				</div>
			</a>
		))}
	</div>
</section>
