---
import { Image } from 'astro:assets';
import { rooms } from '../data/rooms';
import { contact } from '../data/nav';
import { ausUrl, pfad, preis } from '../i18n/ui';

/*
 * Buchungs-/Anfrage-Dialog (Grundbau 12.08.2026, Vorbild Gasthof-Herderich;
 * seit 14.08.2026 12:04 mit ZWEI MODI, KD: "eigenes Buchungsformular was dann
 * die Bestaetigung an Smoobu gibt … aber auch die Anfrageoption ueber uns").
 *
 *  · Modus BUCHEN  — Knoepfe mit `data-buchen="<zimmer-id>"`. VERBINDLICHE
 *    Buchung: POST /api/zimmer-buchen → Verfuegbarkeitspruefung → echte
 *    Smoobu-Reservierung zum WEBSITE-Preis (inkl. Fruehstueck +
 *    Kulturfoerderabgabe; der Server rechnet den Preis selbst, die Anzeige
 *    hier ist nur Anzeige). Felder: Zeitraum, Personen, Vorname, Nachname,
 *    E-Mail, Telefon optional, Nachricht optional, Datenschutz.
 *  · Modus ANFRAGEN — Knoepfe mit `data-anfragen="<zimmer-id>"`. Unverbindliche
 *    Mail ans Haus ueber die BESTEHENDE Resend-Route /api/kontakt (Honeypot,
 *    Datenschutz-Pflicht, Rate-Limit) — wie seit dem 12.08.
 *
 * Elemente, die nur zu einem Modus gehoeren, tragen `data-nur-modus="buchen"`
 * bzw. `"anfragen"` — das Skript blendet sie beim Oeffnen passend um. Das
 * Wording ist bewusst hart getrennt: "Verbindlich buchen" gegen
 * "Unverbindliche Anfrage senden" — KD hat am 14.08. selbst einen Anfrage-
 * Knopf fuer einen Buchen-Knopf gehalten (Commit fe0c346).
 *
 * Fruehstueck + Kulturfoerderabgabe sind bei Website-Preisen immer inklusive
 * (gilt nicht fuer Booking.com) — deshalb der Badge beim Preis.
 */
const { sprache, t } = ausUrl(Astro.url);
const b = t.buchung;
const zimmer = rooms(sprache);
const zimmerDe = rooms('de');

// Was das Skript je Zimmer wissen muss. `nameDe` steht mit drin, weil die
// Mail ans Haus IMMER die deutschen Zimmernamen traegt — der Empfaenger ist
// das Haus, nicht der Gast.
const zimmerDaten = Object.fromEntries(
	zimmer.map((z, i) => [
		z.id,
		{
			name: z.name,
			nameDe: zimmerDe[i].name,
			preis: z.pricePerNight,
			maxGuests: z.maxGuests,
			// Personen-Staffel (Familienzimmer/-Suite, KD 14.08.2026 10:46):
			// `preis` gilt fuer `basis` Personen, jede weitere kostet `aufpreis`/Nacht.
			// `staffelText` kommt fertig uebersetzt mit, weil das Browser-Skript
			// die i18n-Funktionen nicht kennt.
			basis: z.basisPersonen ?? null,
			aufpreis: z.aufpreisProPerson ?? null,
			staffelText:
				z.basisPersonen != null && z.aufpreisProPerson != null
					? b.staffelHinweis(z.basisPersonen, z.aufpreisProPerson)
					: null,
		},
	])
);

// Beschriftungen, die das Browser-Skript dynamisch zusammensetzt (Naechte,
// Summen, Statusmeldungen) — gleiche Technik wie im Kontaktformular.
const texte = {
	nacht: b.nacht,
	naechte: b.naechte,
	gast: b.gast,
	gaeste: b.gaeste,
	gesamt: b.gesamt,
	ab: b.ab,
	proNacht: b.proNacht,
	preisAufAnfrage: b.preisAufAnfrage,
	pflichtHinweis: b.pflichtHinweis,
	emailHinweis: b.emailHinweis,
	fehler: b.fehler,
	keineVerbindung: b.keineVerbindung,
	wirdGesendet: b.wirdGesendet,
	absenden: b.absenden,
	buchenAbsenden: b.buchenAbsenden,
	erfolgText: b.erfolgText,
	buchenErfolgText: b.buchenErfolgText,
	// /api/zimmer-buchen braucht die Seitensprache (Smoobu-Bestaetigung + Meldungen).
	sprache,
	// /api/kontakt antwortet auf Deutsch — nur dort ihre Meldung durchreichen.
	// /api/zimmer-buchen antwortet dagegen in der Seitensprache (immer zeigen).
	serverText: sprache === 'de',
	// Preisformat je Sprache: "101 €" bzw. "€101" (wie preis() in i18n/ui.ts).
	preisVor: sprache === 'de' ? '' : '€',
	preisNach: sprache === 'de' ? ' €' : '',
};

const maxPersonen = Math.max(...zimmer.map((z) => z.maxGuests));
---

<dialog
	id="buchungs-modal"
	class="m-auto w-full max-w-lg bg-transparent p-4 backdrop:bg-black/55"
	data-zimmer={JSON.stringify(zimmerDaten)}
	data-texte={JSON.stringify(texte)}
	aria-label={b.modalTitel}
>
	{/* max-h rechnet das p-4 des Dialogs mit ein — sonst ist der Kasten hoeher
	    als der Dialog und es erscheint eine zweite Scrollleiste daneben. */}
	<div class="flex max-h-[calc(100dvh-4rem)] flex-col overflow-hidden rounded-3xl bg-white shadow-2xl">
		{/* Kopf: Titelbild des gewaehlten Zimmers. Alle Bilder liegen gerendert
		    im Dokument, das Skript blendet nur das passende ein — so bleibt die
		    Bild-Optimierung bei Astro. */}
		<div class="relative h-40 w-full shrink-0 overflow-hidden bg-cream-100 sm:h-48">
			{zimmer.map((room, index) => (
				<Image
					src={room.gallery[0].src}
					alt={room.gallery[0].alt}
					width={640}
					height={384}
					format="webp"
					quality={70}
					loading="lazy"
					decoding="async"
					class={`absolute inset-0 h-full w-full object-cover ${index === 0 ? '' : 'hidden'}`}
					data-buchung-bild={room.id}
				/>
			))}
			<div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/60 to-transparent px-6 pb-3 pt-10">
				<p class="font-akzent text-lg font-semibold text-cream-50" data-buchung-zimmername></p>
			</div>
			<button
				type="button"
				data-buchung-schliessen
				aria-label={b.schliessen}
				class="absolute right-3 top-3 grid h-10 w-10 place-items-center rounded-full bg-black/40 text-cream-50 transition-colors hover:bg-black/60"
			>
				<svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
					<path d="M6 6l12 12M18 6L6 18" />
				</svg>
			</button>
		</div>

		{/* Formular */}
		<form id="buchung-formular" class="flex flex-col gap-4 overflow-y-auto p-6" novalidate>
			{/* Titel + Hinweis je Modus — das Skript blendet die Spans passend um. */}
			<div>
				<h3 class="font-akzent text-2xl font-semibold text-ink-900">
					<span data-nur-modus="anfragen">{b.modalTitel}</span>
					<span data-nur-modus="buchen" class="hidden">{b.buchenTitel}</span>
				</h3>
				<p class="mt-1 text-sm text-ink-700/70">
					<span data-nur-modus="anfragen">{b.modalHinweis}</span>
					<span data-nur-modus="buchen" class="hidden">{b.buchenHinweis}</span>
				</p>
			</div>

			<div class="grid gap-4 sm:grid-cols-2">
				<div class="sm:col-span-2">
					<label for="buchung-zimmer" class="text-sm font-medium text-ink-900">{b.zimmerLabel}</label>
					<select
						id="buchung-zimmer"
						name="zimmer"
						class="mt-1 w-full rounded-lg border border-ink-900/15 px-4 py-2.5 text-sm focus:border-orange-500 focus:outline-none"
					>
						{zimmer.map((room) => (
							<option value={room.id}>{room.name}</option>
						))}
					</select>
				</div>
				<div>
					<label for="buchung-anreise" class="text-sm font-medium text-ink-900">{b.anreise}</label>
					<input
						type="date"
						id="buchung-anreise"
						name="anreise"
						required
						class="mt-1 w-full rounded-lg border border-ink-900/15 px-4 py-2.5 text-sm focus:border-orange-500 focus:outline-none"
					/>
				</div>
				<div>
					<label for="buchung-abreise" class="text-sm font-medium text-ink-900">{b.abreise}</label>
					<input
						type="date"
						id="buchung-abreise"
						name="abreise"
						required
						class="mt-1 w-full rounded-lg border border-ink-900/15 px-4 py-2.5 text-sm focus:border-orange-500 focus:outline-none"
					/>
				</div>
				<div>
					<label for="buchung-personen" class="text-sm font-medium text-ink-900">{b.personen}</label>
					<select
						id="buchung-personen"
						name="personen"
						class="mt-1 w-full rounded-lg border border-ink-900/15 px-4 py-2.5 text-sm focus:border-orange-500 focus:outline-none"
					>
						{Array.from({ length: maxPersonen }, (_, i) => (
							<option value={String(i + 1)}>{i + 1} {i === 0 ? b.gast : b.gaeste}</option>
						))}
					</select>
				</div>
				{/* Naechte x Preis, live gerechnet — beim Zimmer ohne Preis steht hier
				    "Preis auf Anfrage". Darueber der Badge: auf der Website sind
				    Fruehstueck UND Kulturfoerderabgabe im Preis drin (KD 14.08.2026).
				    Darunter der Staffel-Hinweis, nur bei Zimmern mit Personen-Staffel
				    (das Skript fuellt und zeigt ihn je gewaehltem Zimmer). */}
				<div class="flex flex-col justify-end gap-1.5">
					<span class="w-fit rounded-full bg-green-600/10 px-2.5 py-1 text-xs font-semibold text-green-700">
						{b.fruehstueckKultur}
					</span>
					<p
						class="w-full rounded-lg bg-cream-100/80 px-4 py-2.5 text-sm font-semibold text-ink-900"
						data-buchung-summe
						aria-live="polite"
					>
					</p>
					<p class="hidden text-xs text-ink-700/60" data-buchung-staffel></p>
				</div>
			</div>

			<div class="grid gap-4 sm:grid-cols-2">
				{/* Anfrage-Modus: EIN Namensfeld (wie bisher). Buchen-Modus: Vorname +
				    Nachname getrennt — Smoobu braucht beide einzeln, und beim
				    verbindlichen Vertrag soll nichts geraten geteilt werden. Das
				    Formular steht auf `novalidate`, die Pflicht prueft das Skript
				    je Modus. */}
				<div data-nur-modus="anfragen">
					<label for="buchung-name" class="text-sm font-medium text-ink-900">{b.nameLabel}</label>
					<input
						type="text"
						id="buchung-name"
						name="name"
						autocomplete="name"
						class="mt-1 w-full rounded-lg border border-ink-900/15 px-4 py-2.5 text-sm focus:border-orange-500 focus:outline-none"
					/>
				</div>
				<div data-nur-modus="buchen" class="hidden">
					<label for="buchung-vorname" class="text-sm font-medium text-ink-900">{b.vornameLabel}</label>
					<input
						type="text"
						id="buchung-vorname"
						name="vorname"
						autocomplete="given-name"
						class="mt-1 w-full rounded-lg border border-ink-900/15 px-4 py-2.5 text-sm focus:border-orange-500 focus:outline-none"
					/>
				</div>
				<div data-nur-modus="buchen" class="hidden">
					<label for="buchung-nachname" class="text-sm font-medium text-ink-900">{b.nachnameLabel}</label>
					<input
						type="text"
						id="buchung-nachname"
						name="nachname"
						autocomplete="family-name"
						class="mt-1 w-full rounded-lg border border-ink-900/15 px-4 py-2.5 text-sm focus:border-orange-500 focus:outline-none"
					/>
				</div>
				<div>
					<label for="buchung-email" class="text-sm font-medium text-ink-900">{b.emailLabel}</label>
					<input
						type="email"
						id="buchung-email"
						name="email"
						required
						autocomplete="email"
						inputmode="email"
						class="mt-1 w-full rounded-lg border border-ink-900/15 px-4 py-2.5 text-sm focus:border-orange-500 focus:outline-none"
					/>
				</div>
				<div class="sm:col-span-2">
					<label for="buchung-telefon" class="text-sm font-medium text-ink-900">{b.telefonLabel}</label>
					<input
						type="tel"
						id="buchung-telefon"
						name="telefon"
						autocomplete="tel"
						inputmode="tel"
						class="mt-1 w-full rounded-lg border border-ink-900/15 px-4 py-2.5 text-sm focus:border-orange-500 focus:outline-none"
					/>
				</div>
				<div class="sm:col-span-2">
					<label for="buchung-nachricht" class="text-sm font-medium text-ink-900">{b.nachrichtLabel}</label>
					<textarea
						id="buchung-nachricht"
						name="nachricht"
						rows="3"
						placeholder={b.nachrichtPlatzhalter}
						class="mt-1 w-full rounded-lg border border-ink-900/15 px-4 py-2.5 text-sm focus:border-orange-500 focus:outline-none"
					></textarea>
				</div>
			</div>

			<label class="flex items-start gap-2 text-xs text-ink-700/70">
				<input type="checkbox" name="datenschutz" value="ja" required class="mt-0.5 shrink-0 accent-orange-500" />
				<span>
					{b.einwilligung1} <a href={pfad(sprache, '/datenschutz')} target="_blank" class="underline hover:text-orange-600">{b.datenschutzLink}</a>{sprache === 'de' ? ' ' : ''}{b.einwilligung2}
				</span>
			</label>
			<p class="-mt-2 text-xs text-ink-700/50">{b.pflichtfelder}</p>

			{/* Falle fuer Bots — dieselbe wie im Kontaktformular. */}
			<div class="absolute left-[-9999px] h-0 w-0 overflow-hidden" aria-hidden="true">
				<label for="buchung-website">Website</label>
				<input type="text" id="buchung-website" name="website" tabindex="-1" autocomplete="off" />
			</div>

			{/* Statusmeldung direkt UEBER dem Knopf (Herderich-Lehre: am Kopf
			    des Formulars sieht sie auf dem Handy niemand). */}
			<p data-buchung-status class="hidden rounded-lg bg-orange-500/10 px-4 py-3 text-sm text-orange-700" role="status" aria-live="polite"></p>

			<div class="flex flex-col gap-3 sm:flex-row">
				<button
					type="submit"
					class="rounded-full bg-orange-500 px-7 py-3 text-sm font-semibold text-cream-50 transition-colors hover:bg-orange-600 disabled:opacity-60 sm:flex-1"
				>
					{b.absenden}
				</button>
				<a
					href={contact.phoneHref}
					class="rounded-full border border-ink-900/15 px-7 py-3 text-center text-sm font-semibold text-ink-900 transition-colors hover:border-orange-500 hover:text-orange-600"
				>
					{contact.phoneDisplay}
				</a>
			</div>
		</form>

		{/* Erfolgsansicht — ersetzt das Formular, damit niemand doppelt sendet. */}
		<div data-buchung-erfolg class="hidden flex-col gap-4 overflow-y-auto p-6">
			<span class="grid h-12 w-12 place-items-center rounded-2xl bg-orange-500/10 text-orange-600">
				<svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M20 6L9 17l-5-5" />
				</svg>
			</span>
			<h3 class="font-akzent text-2xl font-semibold text-ink-900">
				<span data-nur-modus="anfragen">{b.erfolgTitel}</span>
				<span data-nur-modus="buchen" class="hidden">{b.buchenErfolgTitel}</span>
			</h3>
			{/* Text setzt das Skript je Modus — im Buchen-Modus kommt hier die
			    Server-Meldung mit dem verbindlichen Gesamtpreis hinein. */}
			<p class="text-sm leading-relaxed text-ink-700/80" data-buchung-erfolgtext>{b.erfolgText}</p>
			<p class="rounded-lg bg-cream-100/80 px-4 py-3 text-sm text-ink-700/80">
				<span class="font-semibold text-ink-900">
					<span data-nur-modus="anfragen">{b.erfolgAuswahl}</span>
					<span data-nur-modus="buchen" class="hidden">{b.buchenErfolgAuswahl}</span>
				</span>
				<span data-buchung-erfolg-details></span>
			</p>
			<button
				type="button"
				data-buchung-schliessen
				class="self-start rounded-full border border-ink-900/15 px-7 py-3 text-sm font-semibold text-ink-900 transition-colors hover:border-orange-500 hover:text-orange-600"
			>
				{b.erfolgSchliessen}
			</button>
		</div>
	</div>
</dialog>

<script>
	/*
	 * Steuert den Buchungsanfrage-Dialog. Alles laeuft ueber data-Attribute,
	 * damit die Komponente in beiden Sprachen ohne zweite Fassung funktioniert.
	 */
	const dialog = document.getElementById('buchungs-modal') as HTMLDialogElement | null;

	if (dialog) {
		const zimmerDaten = JSON.parse(dialog.dataset.zimmer ?? '{}') as Record<
			string,
			{
				name: string;
				nameDe: string;
				preis: number | null;
				maxGuests: number;
				basis: number | null;
				aufpreis: number | null;
				staffelText: string | null;
			}
		>;
		const texte = JSON.parse(dialog.dataset.texte ?? '{}') as Record<string, string | boolean>;

		const formular = dialog.querySelector<HTMLFormElement>('#buchung-formular')!;
		const erfolg = dialog.querySelector<HTMLElement>('[data-buchung-erfolg]')!;
		const erfolgDetails = dialog.querySelector<HTMLElement>('[data-buchung-erfolg-details]')!;
		const erfolgTextEl = dialog.querySelector<HTMLElement>('[data-buchung-erfolgtext]')!;
		const nurModus = dialog.querySelectorAll<HTMLElement>('[data-nur-modus]');
		const status = dialog.querySelector<HTMLElement>('[data-buchung-status]')!;
		const zimmerName = dialog.querySelector<HTMLElement>('[data-buchung-zimmername]')!;
		const summe = dialog.querySelector<HTMLElement>('[data-buchung-summe]')!;
		const staffel = dialog.querySelector<HTMLElement>('[data-buchung-staffel]')!;
		const bilder = dialog.querySelectorAll<HTMLElement>('[data-buchung-bild]');

		const zimmerFeld = formular.querySelector<HTMLSelectElement>('#buchung-zimmer')!;
		const anreiseFeld = formular.querySelector<HTMLInputElement>('#buchung-anreise')!;
		const abreiseFeld = formular.querySelector<HTMLInputElement>('#buchung-abreise')!;
		const personenFeld = formular.querySelector<HTMLSelectElement>('#buchung-personen')!;
		const nameFeld = formular.querySelector<HTMLInputElement>('#buchung-name')!;
		const vornameFeld = formular.querySelector<HTMLInputElement>('#buchung-vorname')!;
		const nachnameFeld = formular.querySelector<HTMLInputElement>('#buchung-nachname')!;
		const emailFeld = formular.querySelector<HTMLInputElement>('#buchung-email')!;
		const telefonFeld = formular.querySelector<HTMLInputElement>('#buchung-telefon')!;
		const nachrichtFeld = formular.querySelector<HTMLTextAreaElement>('#buchung-nachricht')!;
		const datenschutzFeld = formular.querySelector<HTMLInputElement>('input[name="datenschutz"]')!;
		const honeypotFeld = formular.querySelector<HTMLInputElement>('#buchung-website')!;
		const sendenKnopf = formular.querySelector<HTMLButtonElement>('button[type="submit"]')!;

		const iso = (d: Date) => {
			const off = d.getTimezoneOffset() * 60000;
			return new Date(d.getTime() - off).toISOString().slice(0, 10);
		};
		const anzeigeDatum = (isoWert: string) => {
			const [j, m, t] = isoWert.split('-');
			return j && m && t ? `${t}.${m}.${j}` : isoWert;
		};
		const geld = (betrag: number) => `${texte.preisVor}${betrag}${texte.preisNach}`;

		function naechte(): number {
			const n = Math.round(
				(new Date(abreiseFeld.value).getTime() - new Date(anreiseFeld.value).getTime()) / 86400000
			);
			return Number.isFinite(n) && n > 0 ? n : 0;
		}

		/** Bild, Titelzeile, Personen-Deckel und die Naechte-x-Preis-Zeile nachziehen. */
		function aktualisiere() {
			const z = zimmerDaten[zimmerFeld.value];
			if (!z) return;

			bilder.forEach((bild) => bild.classList.toggle('hidden', bild.dataset.buchungBild !== zimmerFeld.value));
			zimmerName.textContent = z.name;

			// Mehr Personen als das Zimmer traegt lassen sich nicht auswaehlen.
			let geklemmt = false;
			Array.from(personenFeld.options).forEach((option) => {
				const zuViel = Number(option.value) > z.maxGuests;
				option.hidden = zuViel;
				option.disabled = zuViel;
				if (zuViel && option.selected) geklemmt = true;
			});
			if (geklemmt) personenFeld.value = String(z.maxGuests);

			// Personen-Staffel (Familienzimmer/-Suite): der Basispreis gilt fuer
			// z.basis Personen, jede weitere kostet z.aufpreis pro Nacht — erst
			// NACH dem Klemmen rechnen, damit der geklemmte Wert zaehlt.
			const extra =
				z.basis != null && z.aufpreis != null
					? Math.max(0, Number(personenFeld.value) - z.basis)
					: 0;
			staffel.textContent = z.staffelText ?? '';
			staffel.classList.toggle('hidden', !z.staffelText);

			const n = naechte();
			if (z.preis === null) {
				summe.textContent = String(texte.preisAufAnfrage);
			} else {
				const proNacht = z.preis + extra * (z.aufpreis ?? 0);
				// Sobald Zusatzpersonen zahlen, steht die Rechnung sichtbar da:
				// "136 € + 2 × 15 € = 166 € / Nacht" (KD 14.08.2026).
				const zerlegung =
					extra > 0
						? `${geld(z.preis)} + ${extra} × ${geld(z.aufpreis!)} = ${geld(proNacht)}${texte.proNacht}`
						: null;
				if (n > 0) {
					summe.textContent = zerlegung
						? `${zerlegung} · ${n} ${n === 1 ? texte.nacht : texte.naechte} = ${geld(n * proNacht)} ${texte.gesamt}`
						: `${n} ${n === 1 ? texte.nacht : texte.naechte} × ${geld(proNacht)} = ${geld(n * proNacht)} ${texte.gesamt}`;
				} else {
					summe.textContent = zerlegung ?? `${texte.ab} ${geld(z.preis)}${texte.proNacht}`;
				}
			}
		}

		function melde(text: string) {
			status.textContent = text;
			status.classList.remove('hidden');
		}

		// Welcher Weg gerade offen ist: 'buchen' = verbindliche Smoobu-Buchung,
		// 'anfragen' = unverbindliche Mail ans Haus. Entscheidet der Knopf,
		// der den Dialog geoeffnet hat.
		let modus: 'anfragen' | 'buchen' = 'anfragen';

		function oeffne(zimmerId: string | undefined, neuerModus: 'anfragen' | 'buchen') {
			modus = neuerModus;
			// Alles, was nur zu einem Modus gehoert (Titel, Hinweis, Namensfelder,
			// Erfolgstexte), passend ein-/ausblenden.
			nurModus.forEach((el) => el.classList.toggle('hidden', el.dataset.nurModus !== modus));
			sendenKnopf.textContent = modus === 'buchen' ? String(texte.buchenAbsenden) : String(texte.absenden);
			erfolgTextEl.textContent = modus === 'buchen' ? String(texte.buchenErfolgText) : String(texte.erfolgText);

			// Formular wieder zeigen, falls vorher schon etwas raus war.
			formular.classList.remove('hidden');
			erfolg.classList.add('hidden');
			erfolg.classList.remove('flex');
			status.classList.add('hidden');

			// "Heute" erst beim Oeffnen bestimmen — die Seite ist statisch gebaut,
			// ein Datum aus dem Build waere laengst veraltet.
			const heute = new Date();
			anreiseFeld.min = iso(heute);
			if (!anreiseFeld.value || anreiseFeld.value < anreiseFeld.min) {
				anreiseFeld.value = iso(new Date(heute.getTime() + 86400000));
			}
			abreiseFeld.min = anreiseFeld.value;
			if (!abreiseFeld.value || abreiseFeld.value <= anreiseFeld.value) {
				abreiseFeld.value = iso(new Date(new Date(anreiseFeld.value).getTime() + 86400000));
			}

			if (zimmerId && zimmerDaten[zimmerId]) zimmerFeld.value = zimmerId;
			aktualisiere();
			dialog!.showModal();
		}

		// Alle Zimmer-Knoepfe der Seite oeffnen den Dialog mit ihrem Zimmer —
		// data-buchen im verbindlichen, data-anfragen im unverbindlichen Modus.
		document.querySelectorAll<HTMLElement>('[data-buchen]').forEach((knopf) => {
			knopf.addEventListener('click', () => oeffne(knopf.dataset.buchen || undefined, 'buchen'));
		});
		document.querySelectorAll<HTMLElement>('[data-anfragen]').forEach((knopf) => {
			knopf.addEventListener('click', () => oeffne(knopf.dataset.anfragen || undefined, 'anfragen'));
		});

		dialog.querySelectorAll<HTMLElement>('[data-buchung-schliessen]').forEach((knopf) => {
			knopf.addEventListener('click', () => dialog!.close());
		});
		// Klick auf den abgedunkelten Hintergrund schliesst ebenfalls.
		dialog.addEventListener('click', (ereignis) => {
			if (ereignis.target === dialog) dialog!.close();
		});

		zimmerFeld.addEventListener('change', aktualisiere);
		personenFeld.addEventListener('change', aktualisiere);
		anreiseFeld.addEventListener('change', () => {
			if (abreiseFeld.value && abreiseFeld.value <= anreiseFeld.value) {
				abreiseFeld.value = iso(new Date(new Date(anreiseFeld.value).getTime() + 86400000));
			}
			abreiseFeld.min = anreiseFeld.value;
			aktualisiere();
		});
		abreiseFeld.addEventListener('change', aktualisiere);

		formular.addEventListener('submit', async (ereignis) => {
			ereignis.preventDefault();

			// Pflichtfelder je Modus: Anfrage braucht EIN Namensfeld, die
			// verbindliche Buchung Vorname UND Nachname (Smoobu fuehrt beide).
			const nameOk =
				modus === 'buchen'
					? Boolean(vornameFeld.value.trim() && nachnameFeld.value.trim())
					: Boolean(nameFeld.value.trim());
			const emailOk = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(emailFeld.value.trim());
			if (!nameOk || !emailFeld.value.trim() || !anreiseFeld.value || !abreiseFeld.value || !datenschutzFeld.checked) {
				melde(String(texte.pflichtHinweis));
				return;
			}
			if (!emailOk) {
				melde(String(texte.emailHinweis));
				return;
			}

			const z = zimmerDaten[zimmerFeld.value];
			const n = naechte();

			// Gemeinsame Felder beider Wege.
			const daten = new FormData();
			daten.set('email', emailFeld.value.trim());
			daten.set('anreise', anreiseFeld.value);
			daten.set('abreise', abreiseFeld.value);
			daten.set('personen', personenFeld.value);
			if (telefonFeld.value.trim()) daten.set('telefon', telefonFeld.value.trim());
			daten.set('datenschutz', 'ja');
			daten.set('website', honeypotFeld.value);

			let ziel: string;
			if (modus === 'buchen') {
				/*
				 * VERBINDLICHE Buchung → /api/zimmer-buchen. `zimmerId` ist die
				 * stabile ID aus rooms.ts (Schluessel zur Smoobu-Einheit). Den
				 * PREIS schicken wir absichtlich NICHT mit — der Server rechnet
				 * ihn selbst aus rooms.ts, die Anzeige hier ist nur Anzeige.
				 */
				ziel = '/api/zimmer-buchen';
				daten.set('vorname', vornameFeld.value.trim());
				daten.set('nachname', nachnameFeld.value.trim());
				daten.set('zimmerId', zimmerFeld.value);
				daten.set('sprache', String(texte.sprache));
				daten.set('nachricht', nachrichtFeld.value.trim());
			} else {
				/*
				 * Unverbindliche ANFRAGE → /api/kontakt. Die Mail geht ans HAUS —
				 * deshalb der DEUTSCHE Zimmername und deutsche Preiszeile,
				 * unabhaengig von der Seitensprache. /api/kontakt baut daraus den
				 * Aufenthaltsblock und den Betreff "Anfrage für Zimmer <name>".
				 * Die Personen-Staffel wird aufgeschluesselt, damit Frank sofort
				 * sieht, wie der Betrag zustande kommt.
				 */
				ziel = '/api/kontakt';
				const extra =
					z.basis != null && z.aufpreis != null
						? Math.max(0, Number(personenFeld.value) - z.basis)
						: 0;
				const proNacht = z.preis === null ? null : z.preis + extra * (z.aufpreis ?? 0);
				const nachrichtTeile = [
					nachrichtFeld.value.trim(),
					proNacht === null
						? 'Preis: auf Anfrage (Website nennt keinen Preis)'
						: extra > 0
							? `Preis laut Website: ${n} × (${z.preis} € + ${extra} × ${z.aufpreis} €) = ${n * proNacht} € (inkl. Frühstück & Kulturförderabgabe)`
							: `Preis laut Website: ${n} × ${proNacht} € = ${n * proNacht} € (inkl. Frühstück & Kulturförderabgabe)`,
				].filter(Boolean);
				daten.set('name', nameFeld.value.trim());
				daten.set('betreff', 'Zimmeranfrage');
				daten.set('zimmer', z.nameDe);
				daten.set('nachricht', nachrichtTeile.join('\n\n'));
			}

			sendenKnopf.disabled = true;
			const knopfText = sendenKnopf.textContent;
			sendenKnopf.textContent = String(texte.wirdGesendet);

			try {
				const antwort = await fetch(ziel, {
					method: 'POST',
					body: daten,
					headers: { Accept: 'application/json' },
				});
				const ergebnis = await antwort.json().catch(() => null);

				if (antwort.ok && ergebnis?.ok) {
					// Im Buchen-Modus traegt die Server-Meldung den verbindlichen
					// Gesamtpreis (in Seitensprache) — die zeigen wir statt des
					// statischen Erfolgtexts.
					if (modus === 'buchen' && ergebnis?.meldung) {
						erfolgTextEl.textContent = ergebnis.meldung;
					}
					erfolgDetails.textContent = ` ${z.name} · ${anzeigeDatum(anreiseFeld.value)} – ${anzeigeDatum(abreiseFeld.value)} · ${personenFeld.value} ${personenFeld.value === '1' ? texte.gast : texte.gaeste}`;
					formular.classList.add('hidden');
					erfolg.classList.remove('hidden');
					erfolg.classList.add('flex');
				} else {
					// /api/zimmer-buchen antwortet in der Seitensprache → Meldung
					// immer zeigen (z. B. "im Zeitraum belegt — gern unverbindlich
					// anfragen oder anrufen"). /api/kontakt antwortet deutsch →
					// nur auf der deutschen Seite durchreichen.
					const serverMeldung = modus === 'buchen' || texte.serverText ? ergebnis?.meldung : null;
					melde(serverMeldung ?? String(texte.fehler));
				}
			} catch {
				melde(String(texte.keineVerbindung));
			} finally {
				sendenKnopf.disabled = false;
				sendenKnopf.textContent = knopfText;
			}
		});
	}
</script>
