---
import { Image } from 'astro:assets';
import logo from '../assets/extracted/logo.png';
import { navItems, chefplatzUrl, contact } from '../data/nav';
import { shortOpeningHours } from '../data/hours';
import { ausUrl, pfad } from '../i18n/ui';

const { sprache, t } = ausUrl(Astro.url);
const punkte = navItems(sprache);
const startseite = pfad(sprache, '/');
const hotelSeite = pfad(sprache, '/hotel');

const currentPath = Astro.url.pathname.replace(/(.)\/$/, '$1');
---

<div class="hidden bg-ink-900 text-cream-50 md:block">
	<div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-2 text-xs tracking-wide text-cream-100/80">
		<div class="flex items-center gap-6">
			<a href={contact.phoneHref} class="hover:text-orange-400">{contact.phoneDisplay}</a>
			<span>·</span>
			<a href={`mailto:${contact.email}`} class="hover:text-orange-400">{contact.email}</a>
		</div>
		<p>{shortOpeningHours(sprache)}</p>
	</div>
</div>

<header class="sticky top-0 z-50 border-b border-ink-900/10 bg-cream-50/95 backdrop-blur">
	<div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-6 py-3">
		<a href={startseite} class="shrink-0">
			<Image src={logo} alt={t.allgemein.logoAlt} width={420} height={176} class="h-16 w-auto md:h-20" />
		</a>

		<nav class="hidden gap-7 lg:flex">
			{punkte.map((item) => {
				const isActive = currentPath === item.href.replace(/(.)\/$/, '$1');
				return (
					<a
						href={item.href}
						class:list={[
							'text-sm font-medium tracking-wide transition-colors hover:text-orange-500',
							isActive ? 'text-orange-500' : 'text-ink-900',
						]}
					>
						{item.label}
					</a>
				);
			})}
		</nav>

		<div class="hidden items-center gap-3 md:flex">
			<a
				href={chefplatzUrl}
				target="_blank"
				rel="noopener noreferrer"
				class="rounded-full border border-ink-900/20 px-5 py-2.5 text-sm font-semibold text-ink-900 transition-colors hover:border-orange-500 hover:text-orange-500"
			>
				{t.allgemein.tischReservieren}
			</a>
			<a
				href={hotelSeite}
				class="rounded-full bg-orange-500 px-5 py-2.5 text-sm font-semibold text-cream-50 shadow-sm transition-colors hover:bg-orange-600"
			>
				{t.allgemein.hotelBuchen}
			</a>
		</div>

		<details class="relative lg:hidden">
			<summary class="list-none rounded-md border border-ink-900/20 px-3 py-2 text-sm text-ink-900">
				{t.allgemein.menue}
			</summary>
			<nav class="absolute right-0 mt-2 flex w-56 flex-col gap-1 rounded-lg border border-ink-900/10 bg-cream-50 p-3 shadow-lg">
				{punkte.map((item) => (
					<a href={item.href} class="rounded px-3 py-2 text-sm font-medium text-ink-900 hover:bg-orange-50">
						{item.label}
					</a>
				))}
				<hr class="my-1 border-ink-900/10" />
				<a
					href={chefplatzUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="rounded px-3 py-2 text-sm font-semibold text-ink-900 hover:bg-orange-50"
				>
					{t.allgemein.tischReservieren}
				</a>
				<a href={hotelSeite} class="rounded bg-orange-500 px-3 py-2 text-center text-sm font-semibold text-cream-50">
					{t.allgemein.hotelBuchen}
				</a>
				<p class="px-3 pt-1 text-xs text-ink-900/60">{shortOpeningHours(sprache)}</p>
			</nav>
		</details>
	</div>
</header>
