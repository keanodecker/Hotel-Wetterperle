---
import { Image } from 'astro:assets';
import { partners } from '../data/partners';

// Für ein nahtlos laufendes Band wird die Liste vervielfacht: die Animation läuft bis -50%,
// daher müssen die ersten beiden Kopien zusammen breiter als der Bildschirm sein, sonst
// entsteht eine sichtbare Lücke. Vier Kopien (= zwei identische Hälften) füllen jede Breite.
const track = [...partners, ...partners, ...partners, ...partners];
---

<section class="overflow-hidden py-20">
	<div class="mx-auto mb-12 max-w-6xl px-6 text-center">
		<p class="font-serif text-sm uppercase tracking-[0.3em] text-orange-600">Regional verwurzelt</p>
		<h2 class="mt-3 font-serif text-3xl font-semibold text-ink-900 md:text-4xl">
			Unsere Partner &amp; Lieferanten
		</h2>
		<p class="mx-auto mt-4 max-w-xl leading-relaxed text-ink-700/80">
			Frische, Regionalität und faire Zusammenarbeit – diese Betriebe machen unsere
			Küche erst möglich.
		</p>
	</div>

	<div class="relative">
		<div class="marquee-track flex w-max animate-marquee items-center gap-16 px-6 md:gap-20">
			{track.map((partner) => (
				<Image
					src={partner.logo}
					alt={partner.name}
					width={200}
					height={200}
					class="h-28 w-auto shrink-0 object-contain opacity-80 grayscale transition-all duration-300 hover:-translate-y-1 hover:opacity-100 hover:grayscale-0 md:h-32"
				/>
			))}
		</div>
	</div>
</section>
