---
import { Image } from 'astro:assets';
import { partners } from '../data/partners';
---

<section class="mx-auto max-w-6xl px-6 py-20">
	<div class="mb-12 text-center">
		<p class="font-serif text-sm uppercase tracking-[0.3em] text-orange-600">Regional verwurzelt</p>
		<h2 class="mt-3 font-serif text-3xl font-semibold text-ink-900 md:text-4xl">
			Unsere Partner &amp; Lieferanten
		</h2>
		<p class="mx-auto mt-4 max-w-xl leading-relaxed text-ink-700/80">
			Frische, Regionalität und faire Zusammenarbeit – diese Betriebe machen unsere
			Küche erst möglich.
		</p>
	</div>

	<div class="grid grid-cols-2 gap-8 sm:grid-cols-3 md:grid-cols-6">
		{partners.map((partner) => (
			<div class="flex items-center justify-center rounded-2xl border border-ink-900/10 bg-white p-6 grayscale transition-all hover:grayscale-0">
				<Image src={partner.logo} alt={partner.name} width={96} height={96} class="h-16 w-16 object-contain" />
			</div>
		))}
	</div>
</section>
