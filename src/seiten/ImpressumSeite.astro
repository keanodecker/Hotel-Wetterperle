---
// Inhalt 1:1 von der alten Website wetteraperle.de uebernommen (KD-Ansage 14.08.2026).
// Zwei bewusste Abweichungen: § 5 TMG -> § 5 DDG (das TMG ist seit Mai 2024 abgeloest)
// und der Verweis auf die EU-OS-Plattform ist raus (die Plattform wurde Mitte 2025
// eingestellt). Die englische Fassung ist eine Uebersetzung, massgeblich ist Deutsch.
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { contact } from '../data/nav';
import { ausUrl } from '../i18n/ui';

const { t } = ausUrl(Astro.url);
const s = t.impressumSeite;
---

<Layout title={s.titel} description={s.beschreibung}>
	<PageHeader kicker={s.kicker} title={s.ueberschrift} />

	<section class="mx-auto max-w-3xl space-y-10 px-6 py-20 text-sm leading-relaxed text-ink-700/90">
		<div>
			<h2 class="font-akzent text-xl font-semibold text-ink-900">{s.angabenTitel}</h2>
			<p class="mt-3">
				{contact.name}<br />
				{s.inhaber}<br />
				{contact.street}<br />
				{contact.zipCity}
			</p>
		</div>

		<div>
			<h2 class="font-akzent text-xl font-semibold text-ink-900">{s.kontaktTitel}</h2>
			<p class="mt-3">
				{s.telefonLabel}: <a href={contact.phoneHref} class="font-medium text-orange-600">{contact.phoneDisplay}</a><br />
				{s.telefaxLabel}: {s.telefax}<br />
				{s.emailLabel}: <a href={`mailto:${contact.email}`} class="font-medium text-orange-600">{contact.email}</a>
			</p>
		</div>

		<div>
			<h2 class="font-akzent text-xl font-semibold text-ink-900">{s.ustTitel}</h2>
			<p class="mt-3">
				{s.ustText}<br />
				{s.ustId}
			</p>
		</div>

		{s.abschnitte.map((abschnitt) => (
			<div>
				<h2 class="font-akzent text-xl font-semibold text-ink-900">{abschnitt.titel}</h2>
				<p class="mt-3">{abschnitt.text}</p>
			</div>
		))}
	</section>
</Layout>
