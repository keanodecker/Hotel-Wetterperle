---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import PhotoGrid from '../components/PhotoGrid.astro';
import { Image } from 'astro:assets';
import events from '../assets/extracted/events.jpg';
import feiern1 from '../assets/gallery/feiern/feiern-01.jpg';
import feiern2 from '../assets/gallery/feiern/feiern-02.jpg';
import saalHell from '../assets/gallery/feiern/saal-hell-fenster.jpg';
import saalWeit from '../assets/gallery/feiern/saal-weit-bar.jpg';
import { contact } from '../data/nav';
import { ausUrl } from '../i18n/ui';

const { t } = ausUrl(Astro.url);
const s = t.feiernSeite;

const galerie = [saalHell, saalWeit, feiern2, feiern1].map((src, i) => ({
	src,
	alt: s.galerie[i],
}));
---

<Layout title={s.titel} description={s.beschreibung}>
	<PageHeader kicker={s.kicker} title={s.ueberschrift} description={s.einleitung} />

	<section class="mx-auto grid max-w-6xl gap-12 px-6 py-20 md:grid-cols-2 md:items-center">
		<div class="order-2 md:order-1">
			<p class="font-akzent text-sm uppercase tracking-[0.3em] text-orange-600">{s.mottoKicker}</p>
			<h2 class="mt-3 font-akzent text-3xl font-semibold text-ink-900 md:text-4xl">
				{s.mottoTitel}
			</h2>
			<p class="mt-4 leading-relaxed text-ink-700/80">
				{s.mottoText}
			</p>
			<a
				href={contact.phoneHref}
				class="mt-6 inline-block rounded-full bg-orange-500 px-7 py-3 text-sm font-semibold text-cream-50 transition-colors hover:bg-orange-600"
			>
				{s.anfragen}: {contact.phoneDisplay}
			</a>
		</div>
		<Image
			src={events}
			alt={s.bildAlt}
			class="order-1 h-80 w-full rounded-3xl object-cover md:order-2 md:h-[26rem]"
		/>
	</section>

	<section class="bg-cream-100/60">
		<div class="mx-auto max-w-6xl px-6 py-20">
			<h2 class="mb-12 text-center font-akzent text-3xl font-semibold text-ink-900 md:text-4xl">
				{s.anlaesseTitel}
			</h2>
			<div class="grid gap-8 md:grid-cols-2">
				{s.anlaesse.map((anlass) => (
					<div class="rounded-2xl border border-ink-900/10 bg-white p-8">
						<h3 class="font-akzent text-xl font-semibold text-ink-900">{anlass.titel}</h3>
						<p class="mt-3 text-sm leading-relaxed text-ink-700/80">{anlass.text}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<section class="mx-auto max-w-6xl px-6 py-20">
		<h2 class="mb-8 font-akzent text-2xl font-semibold text-ink-900">{s.momente}</h2>
		<PhotoGrid images={galerie} />
	</section>
</Layout>
