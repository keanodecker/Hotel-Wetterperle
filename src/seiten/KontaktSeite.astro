---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { openingHours } from '../data/hours';
import { contact } from '../data/nav';
import { rooms } from '../data/rooms';
import { Image } from 'astro:assets';
import gastraumStimmung from '../assets/gallery/haus/gastraum-stimmung.jpg';
import { ausUrl, pfad } from '../i18n/ui';

const { sprache, t } = ausUrl(Astro.url);
const s = t.kontaktSeite;

/*
 * Die Rueckmeldungen des Formulars stehen als data-Attribut am <form>, weil
 * das Skript unten im Browser laeuft und `t` dort nicht kennt.
 * `serverText`: Die API-Route (src/pages/api/kontakt.ts) antwortet auf DEUTSCH.
 * Auf der deutschen Seite zeigen wir deshalb weiter ihre genaue Meldung; auf
 * der englischen Seite die eigene Uebersetzung, damit dort keine deutsche
 * Zeile auftaucht. Die Route selbst bleibt unveraendert.
 */
const formularTexte = {
	erfolg: s.erfolg,
	fehler: s.fehler,
	keineVerbindung: s.keineVerbindung,
	wirdGesendet: s.wirdGesendet,
	absenden: s.absenden,
	serverText: sprache === 'de',
};

/*
 * Die Zimmerfelder erscheinen NUR bei „Zimmeranfrage" (KD 12.08.2026: „Aber nur
 * wenn er auf Zimmeranfrage klickt"). Verglichen wird gegen den Text der Option —
 * er steht in i18n/ui.ts an INDEX 1 der `anliegenOptionen`. Deshalb hier aus dem
 * Array gelesen und nicht abgetippt: sonst laeuft eine Uebersetzung still
 * auseinander und der Block erscheint nie.
 */
const ZIMMER_ANFRAGE = s.anliegenOptionen[1];

/* Auswahl der Zimmer kommt aus denselben Daten wie die Zimmerseite — kommt ein
   Zimmer dazu, steht es hier automatisch mit drin. ANGEZEIGT wird der Name in
   der Seitensprache, als WERT geht der deutsche Name mit: Die Anfrage-Mail geht
   ans Haus, und /api/kontakt baut daraus den Betreff „Anfrage für Zimmer <name>"
   (KD 14.08.2026 — Anfrage per Mail statt Smoobu-Direktbuchung). */
const zimmerDe = rooms('de');
const zimmerAuswahl = rooms(sprache).map((r, i) => ({ name: r.name, nameDe: zimmerDe[i].name }));

/* Anreise fruehestens heute: ein Datum in der Vergangenheit ist immer ein
   Vertipper, und Frank soll ihn nicht per Rueckfrage klaeren muessen. */
const heute = new Date().toISOString().slice(0, 10);
---

<Layout title={s.titel} description={s.beschreibung}>
	<PageHeader kicker={s.kicker} title={s.ueberschrift} description={s.einleitung} />

	<section class="mx-auto max-w-6xl px-6 pt-16">
		<Image
			src={gastraumStimmung}
			alt={s.bildAlt}
			class="h-72 w-full rounded-3xl object-cover md:h-96"
		/>
	</section>

	<section class="mx-auto max-w-6xl px-6 py-20">
		<div class="grid gap-12 md:grid-cols-2">
			<div>
				<h2 class="font-akzent text-2xl font-semibold text-ink-900">{s.formTitel}</h2>
				<form
					id="anfrage-formular"
					class="mt-6 flex flex-col gap-4"
					method="post"
					action="/api/kontakt"
					data-texte={JSON.stringify(formularTexte)}
				>
					<div class="grid gap-4 sm:grid-cols-2">
						<div>
							<label for="name" class="text-sm font-medium text-ink-900">{s.name}</label>
							<input
								type="text"
								id="name"
								name="name"
								required
								class="mt-1 w-full rounded-lg border border-ink-900/15 px-4 py-2.5 text-sm focus:border-orange-500 focus:outline-none"
							/>
						</div>
						<div>
							<label for="email" class="text-sm font-medium text-ink-900">{s.email}</label>
							<input
								type="email"
								id="email"
								name="email"
								required
								class="mt-1 w-full rounded-lg border border-ink-900/15 px-4 py-2.5 text-sm focus:border-orange-500 focus:outline-none"
							/>
						</div>
					</div>
					<div>
						<label for="betreff" class="text-sm font-medium text-ink-900">{s.anliegen}</label>
						<select id="betreff" name="betreff" class="feld-select mt-1">
							{s.anliegenOptionen.map((option) => (
								<option>{option}</option>
							))}
						</select>
					</div>

					{/*
					 * Zimmerfelder — eingeklappt, bis oben „Zimmeranfrage" gewaehlt ist.
					 * `hidden` allein reicht nicht: die Felder wuerden sonst leer
					 * mitgeschickt werden. Das Skript unten setzt zusaetzlich `disabled`,
					 * damit ausgeblendete Felder GAR NICHT im FormData landen — sonst
					 * steht in jeder Sonstiges-Mail ein leerer Zimmerblock.
					 */}
					<fieldset
						id="zimmer-felder"
						data-anliegen={ZIMMER_ANFRAGE}
						class="hidden rounded-2xl border border-ink-900/10 bg-cream-50/60 p-5"
						disabled
					>
						<legend class="px-1 text-sm font-medium text-ink-900">{s.zimmerBlockTitel}</legend>
						<p class="mb-4 text-xs text-ink-700/70">{s.zimmerBlockHinweis}</p>

						<div class="grid gap-4 sm:grid-cols-2">
							<div>
								<label for="anreise" class="text-sm font-medium text-ink-900">{s.anreise}</label>
								<input
									type="date"
									id="anreise"
									name="anreise"
									min={heute}
									class="mt-1 w-full rounded-lg border border-ink-900/15 px-4 py-2.5 text-sm focus:border-orange-500 focus:outline-none"
								/>
							</div>
							<div>
								<label for="abreise" class="text-sm font-medium text-ink-900">{s.abreise}</label>
								<input
									type="date"
									id="abreise"
									name="abreise"
									min={heute}
									class="mt-1 w-full rounded-lg border border-ink-900/15 px-4 py-2.5 text-sm focus:border-orange-500 focus:outline-none"
								/>
							</div>
							{/* Wert = DEUTSCHER Zimmername (Mail ans Haus), Anzeige in Seitensprache. */}
							<div>
								<label for="zimmer" class="text-sm font-medium text-ink-900">{s.zimmerart}</label>
								<select id="zimmer" name="zimmer" class="feld-select mt-1">
									<option value="">{s.zimmerartEgal}</option>
									{zimmerAuswahl.map((zimmer) => (
										<option value={zimmer.nameDe}>{zimmer.name}</option>
									))}
								</select>
							</div>
							<div>
								<label for="personen" class="text-sm font-medium text-ink-900">{s.personen}</label>
								<input
									type="number"
									id="personen"
									name="personen"
									min="1"
									max="20"
									value="2"
									class="mt-1 w-full rounded-lg border border-ink-900/15 px-4 py-2.5 text-sm focus:border-orange-500 focus:outline-none"
								/>
							</div>
							<div class="sm:col-span-2">
								<label for="telefon" class="text-sm font-medium text-ink-900">{s.telefonFeld}</label>
								<input
									type="tel"
									id="telefon"
									name="telefon"
									class="mt-1 w-full rounded-lg border border-ink-900/15 px-4 py-2.5 text-sm focus:border-orange-500 focus:outline-none"
								/>
							</div>
						</div>

						<p class="mt-4 text-xs text-ink-700/60">{s.nurAnfragen}</p>
					</fieldset>
					<div>
						<label for="nachricht" class="text-sm font-medium text-ink-900">{s.nachricht}</label>
						<textarea
							id="nachricht"
							name="nachricht"
							rows="5"
							class="mt-1 w-full rounded-lg border border-ink-900/15 px-4 py-2.5 text-sm focus:border-orange-500 focus:outline-none"
						></textarea>
					</div>
					{/*
						Einwilligung: absichtlich VOR dem Knopf — erst zustimmen, dann absenden.
						Der Server prueft dasselbe noch einmal (Feld `datenschutz` in
						src/pages/api/kontakt.ts) — ein `required` im Browser ist bequem,
						aber kein Schutz.
					*/}
					<label class="flex items-start gap-2 text-xs text-ink-700/70">
						<input
							type="checkbox"
							name="datenschutz"
							value="ja"
							required
							class="feld-checkbox mt-0.5"
						/>
						<span>
							{s.einwilligung1} <a href={pfad(sprache, '/datenschutz')} class="underline hover:text-orange-600"
								>{s.datenschutzLink}</a
							>{sprache === 'de' ? ' ' : ''}{s.einwilligung2}
						</span>
					</label>
					<button
						type="submit"
						class="mt-2 self-start rounded-full bg-orange-500 px-7 py-3 text-sm font-semibold text-cream-50 transition-colors hover:bg-orange-600"
					>
						{s.absenden}
					</button>
					{/* Falle für Bots: für Menschen unsichtbar, wird nie ausgefüllt. */}
					<div class="absolute left-[-9999px] h-0 w-0 overflow-hidden" aria-hidden="true">
						<label for="website">{s.honeypot}</label>
						<input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
					</div>
					<p id="anfrage-status" class="hidden text-sm" role="status" aria-live="polite"></p>
				</form>
			</div>

			<div>
				<h2 class="font-akzent text-2xl font-semibold text-ink-900">{s.erreichen}</h2>
				<ul class="mt-6 space-y-4 text-sm text-ink-700/80">
					<li>
						<span class="block font-medium text-ink-900">{s.adresse}</span>
						{contact.street}, {contact.zipCity}
					</li>
					<li>
						<span class="block font-medium text-ink-900">{s.telefon}</span>
						<a href={contact.phoneHref} class="hover:text-orange-600">{contact.phoneDisplay}</a>
					</li>
					<li>
						<span class="block font-medium text-ink-900">{s.email}</span>
						<a href={`mailto:${contact.email}`} class="hover:text-orange-600">{contact.email}</a>
					</li>
				</ul>

				<h3 class="mt-8 font-akzent text-lg font-semibold text-ink-900">{t.allgemein.oeffnungszeiten}</h3>
				<ul class="mt-3 space-y-2 text-sm">
					{openingHours(sprache).map((entry) => (
						<li class="flex justify-between gap-4">
							<span class="font-medium text-ink-900">{entry.label}</span>
							<span class="text-ink-700/70">{entry.ranges ? entry.ranges.join(' · ') : t.allgemein.ruhetag}</span>
						</li>
					))}
				</ul>

				<div class="mt-8 overflow-hidden rounded-2xl border border-ink-900/10">
					<iframe
						src={contact.mapEmbedSrc}
						class="h-64 w-full"
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						title={s.karteTitel}
					></iframe>
				</div>
			</div>
		</div>
	</section>
<script>
	// Schickt das Formular per fetch an /api/kontakt und zeigt die Antwort an,
	// statt die Seite neu zu laden. Ohne JavaScript greift das normale
	// POST-Verhalten des Formulars — der Endpoint antwortet dann als JSON.
	const formular = document.getElementById('anfrage-formular');
	const status = document.getElementById('anfrage-status');

	const anliegen = document.getElementById('betreff');
	const zimmerFelder = document.getElementById('zimmer-felder');

	if (formular instanceof HTMLFormElement && status) {
		const knopf = formular.querySelector('button[type="submit"]');

		// Beschriftungen in der Sprache der Seite (siehe Kommentar oben im Frontmatter).
		const texte = {
			erfolg: 'Vielen Dank für Ihre Nachricht.',
			fehler: 'Die Nachricht konnte nicht verschickt werden. Bitte rufen Sie uns an.',
			keineVerbindung:
				'Keine Verbindung zum Server. Bitte prüfen Sie Ihre Internetverbindung oder rufen Sie uns an.',
			wirdGesendet: 'Wird gesendet …',
			absenden: 'Anfrage senden',
			serverText: true,
			...JSON.parse(formular.dataset.texte ?? '{}'),
		};

		/*
		 * Zimmerfelder ein- und ausblenden — ALLES geht als ANFRAGE-Mail an
		 * /api/kontakt (KD-Rückbau 14.08.2026; der Smoobu-Direktweg /api/zimmer-buchen
		 * ist gelöscht, verbindlich gebucht wird nur im Buchungssystem auf /hotel).
		 * `disabled` wird beim Ausblenden MITGESCHALTET, nicht nur `hidden`: ein
		 * ausgeblendetes, aber aktives Feld wandert trotzdem ins FormData und
		 * erzeugt in jeder anderen Anfrage einen leeren Zimmerblock.
		 */
		if (anliegen instanceof HTMLSelectElement && zimmerFelder instanceof HTMLFieldSetElement) {
			const auslöser = zimmerFelder.dataset.anliegen;
			const umschalten = () => {
				const an = anliegen.value === auslöser;
				zimmerFelder.classList.toggle('hidden', !an);
				zimmerFelder.disabled = !an;
			};
			anliegen.addEventListener('change', umschalten);
			umschalten(); // auch beim Laden, falls der Browser eine Auswahl wiederherstellt
		}

		const melden = (text: string, erfolg: boolean) => {
			status.textContent = text;
			status.classList.remove('hidden');
			status.classList.toggle('text-green-700', erfolg);
			status.classList.toggle('text-red-700', !erfolg);
		};

		formular.addEventListener('submit', async (ereignis) => {
			ereignis.preventDefault();
			if (knopf instanceof HTMLButtonElement) {
				knopf.disabled = true;
				knopf.textContent = texte.wirdGesendet;
			}

			try {
				const antwort = await fetch(formular.action, {
					method: 'POST',
					body: new FormData(formular),
					headers: { Accept: 'application/json' },
				});
				const ergebnis = await antwort.json().catch(() => null);

				if (antwort.ok && ergebnis?.ok) {
					formular.reset();
					melden(texte.serverText ? (ergebnis.meldung ?? texte.erfolg) : texte.erfolg, true);
				} else {
					melden(texte.serverText ? (ergebnis?.meldung ?? texte.fehler) : texte.fehler, false);
				}
			} catch {
				melden(texte.keineVerbindung, false);
			} finally {
				if (knopf instanceof HTMLButtonElement) {
					knopf.disabled = false;
					knopf.textContent = texte.absenden;
				}
			}
		});
	}
</script>
</Layout>
