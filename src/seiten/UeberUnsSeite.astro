---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { Image } from 'astro:assets';
import owners from '../assets/extracted/owners.jpg';
import treppe from '../assets/gallery/haus/treppe-historisch.jpg';
import feengrotten from '../assets/gallery/umgebung/feengrotten.jpg';
import saaleschleife from '../assets/gallery/umgebung/saaleschleife-burgk.jpg';
import saalburg from '../assets/gallery/umgebung/saalburg-thueringer-meer.jpg';
import wildwasserbahn from '../assets/gallery/umgebung/wildwasserbahn-plohn.jpg';
import { ausUrl } from '../i18n/ui';

const { t } = ausUrl(Astro.url);
const s = t.ueberUnsSeite;

// Reihenfolge = Reihenfolge der ziele in ui.ts (Saalburg an Platz 3, KD 14.08.2026)
const bilder = [feengrotten, saaleschleife, saalburg, wildwasserbahn];
const ausflugsziele = s.ziele.map((ziel, i) => ({
	...ziel,
	image: bilder[i],
	href: 'href' in ziel ? ziel.href : undefined,
	bildnachweis: 'bildnachweis' in ziel ? ziel.bildnachweis : undefined,
}));
---

<Layout title={s.titel} description={s.beschreibung}>
	<PageHeader kicker={s.kicker} title={s.ueberschrift} description={s.einleitung} />

	<section class="mx-auto grid max-w-6xl gap-12 px-6 py-20 md:grid-cols-2 md:items-center">
		<Image
			src={owners}
			alt={t.geschichte.bildAlt}
			class="h-72 w-72 justify-self-center rounded-full object-cover shadow-xl ring-8 ring-white"
		/>
		<div>
			<p class="font-akzent text-sm uppercase tracking-[0.3em] text-orange-600">{s.inhaberKicker}</p>
			<h2 class="mt-3 font-akzent text-3xl font-semibold text-ink-900 md:text-4xl">
				{s.inhaberTitel}
			</h2>
			<p class="mt-4 leading-relaxed text-ink-700/80">
				{s.inhaberText}
			</p>
		</div>
	</section>

	<section class="bg-ink-900">
		<div class="mx-auto max-w-5xl px-6 py-20">
			<h2 class="mb-12 text-center font-akzent text-3xl font-semibold text-cream-50 md:text-4xl">
				{s.hausTitel}
			</h2>
			<div class="grid gap-12 md:grid-cols-[1fr_1.2fr] md:items-center">
				<Image
					src={treppe}
					alt={s.treppeAlt}
					class="h-80 w-full rounded-3xl object-cover md:h-[28rem]"
				/>
				<ol class="space-y-8 border-l border-cream-50/20 pl-8">
					{s.zeitstrahl.map((station) => (
						<li class="relative">
							<span class="absolute -left-[2.15rem] top-1.5 h-3 w-3 rounded-full bg-orange-500"></span>
							<p class="font-akzent text-sm font-semibold uppercase tracking-wider text-orange-400">{station.zeit}</p>
							<p class="mt-1 text-cream-100/80">{station.text}</p>
						</li>
					))}
				</ol>
			</div>
		</div>
	</section>

	<section class="mx-auto max-w-6xl px-6 py-20">
		<h2 class="mb-12 text-center font-akzent text-3xl font-semibold text-ink-900 md:text-4xl">
			{s.werteTitel}
		</h2>
		<div class="grid gap-8 md:grid-cols-3">
			{s.werte.map((wert) => (
				<div class="rounded-2xl border border-ink-900/10 bg-white p-8">
					<h3 class="font-akzent text-xl font-semibold text-ink-900">{wert.titel}</h3>
					<p class="mt-3 text-sm leading-relaxed text-ink-700/80">{wert.text}</p>
				</div>
			))}
		</div>
	</section>

	<section class="bg-cream-100/60">
		<div class="mx-auto max-w-6xl px-6 py-20">
			<div class="mb-12 max-w-2xl">
				<p class="font-akzent text-sm uppercase tracking-[0.3em] text-orange-600">{s.umgebungKicker}</p>
				<h2 class="mt-3 font-akzent text-3xl font-semibold text-ink-900 md:text-4xl">
					{s.umgebungTitel}
				</h2>
				<p class="mt-4 leading-relaxed text-ink-700/80">
					{s.umgebungText}
				</p>
			</div>
			{/* Alle Ziele auf EINER Linie (KD 14.08.2026) — ab lg vier Spalten */}
			<div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
				{ausflugsziele.map((ziel) =>
					ziel.href ? (
						<a
							href={ziel.href}
							target="_blank"
							rel="noopener noreferrer"
							class="group overflow-hidden rounded-2xl border border-ink-900/10 bg-white no-underline transition-all hover:-translate-y-1 hover:shadow-lg"
						>
							<Image src={ziel.image} alt={ziel.titel} class="h-48 w-full object-cover transition-transform duration-700 group-hover:scale-105" />
							<div class="p-6">
								<h3 class="font-akzent text-lg font-semibold text-ink-900">{ziel.titel}</h3>
								<p class="mt-2 text-sm leading-relaxed text-ink-700/80">{ziel.text}</p>
								{ziel.bildnachweis && (
									<p class="mt-3 text-[10px] leading-tight text-ink-700/40">{ziel.bildnachweis}</p>
								)}
							</div>
						</a>
					) : (
						<div class="overflow-hidden rounded-2xl border border-ink-900/10 bg-white">
							<Image src={ziel.image} alt={ziel.titel} class="h-48 w-full object-cover" />
							<div class="p-6">
								<h3 class="font-akzent text-lg font-semibold text-ink-900">{ziel.titel}</h3>
								<p class="mt-2 text-sm leading-relaxed text-ink-700/80">{ziel.text}</p>
							</div>
						</div>
					)
				)}
			</div>
		</div>
	</section>
</Layout>
