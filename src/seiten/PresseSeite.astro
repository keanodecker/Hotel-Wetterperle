---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { contact } from '../data/nav';
import { ausUrl } from '../i18n/ui';

const { t } = ausUrl(Astro.url);
const s = t.presseSeite;
---

<Layout title={s.titel} description={s.beschreibung}>
	<PageHeader kicker={s.kicker} title={s.ueberschrift} description={s.einleitung} />

	<section class="mx-auto max-w-6xl px-6 py-20">
		<h2 class="mb-8 font-akzent text-2xl font-semibold text-ink-900">{s.faktenTitel}</h2>
		<dl class="grid gap-6 sm:grid-cols-2">
			{s.fakten.map((fakt) => (
				<div class="rounded-2xl border border-ink-900/10 bg-white p-6">
					<dt class="text-xs font-semibold uppercase tracking-wider text-orange-600">{fakt.label}</dt>
					<dd class="mt-2 text-sm leading-relaxed text-ink-900">{fakt.wert}</dd>
				</div>
			))}
		</dl>
	</section>

	<section class="bg-ink-900">
		<div class="mx-auto max-w-6xl px-6 py-20">
			<h2 class="mb-10 font-akzent text-2xl font-semibold text-cream-50">{s.auszeichnungenTitel}</h2>
			<div class="grid gap-8 sm:grid-cols-3">
				{s.auszeichnungen.map((item) => (
					<div class="rounded-2xl bg-cream-50/5 p-8 text-center ring-1 ring-cream-50/10">
						<p class="font-akzent text-3xl font-semibold text-orange-400">{item.titel}</p>
						<p class="mt-2 text-sm text-cream-100/80">{item.text}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<section class="mx-auto max-w-4xl px-6 py-20">
		<div class="grid gap-10 rounded-3xl border border-ink-900/10 bg-white p-10 md:grid-cols-2">
			<div>
				<h2 class="font-akzent text-2xl font-semibold text-ink-900">{s.pressekontakt}</h2>
				<p class="mt-3 text-sm leading-relaxed text-ink-700/80">
					{s.pressekontaktText}
				</p>
				<ul class="mt-4 space-y-2 text-sm">
					<li>
						<a href={`mailto:${contact.email}`} class="font-semibold text-orange-600">{contact.email}</a>
					</li>
					<li>
						<a href={contact.phoneHref} class="font-semibold text-orange-600">{contact.phoneDisplay}</a>
					</li>
				</ul>
			</div>
			<div>
				<h2 class="font-akzent text-2xl font-semibold text-ink-900">{s.bildmaterial}</h2>
				<p class="mt-3 text-sm leading-relaxed text-ink-700/80">
					{s.bildmaterialText}
				</p>
				<span
					class="mt-4 inline-block cursor-not-allowed rounded-full border border-ink-900/20 px-6 py-3 text-sm font-semibold text-ink-900/40"
					aria-disabled="true"
				>
					{s.presseKit}
				</span>
			</div>
		</div>
	</section>
</Layout>
