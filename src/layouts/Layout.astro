---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Landgasthof Wetteraperle',
	description = 'Landgasthof Wetteraperle in Saalburg-Ebersdorf – Restaurant, Hotelzimmer und Feiern mitten im Thüringer Schiefergebirge.',
} = Astro.props;
---

<!doctype html>
<html lang="de">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title} | Landgasthof Wetteraperle</title>
		<!-- Schriften werden lokal aus /public/fonts ausgeliefert (siehe global.css).
		     KEIN Google-Fonts-CDN: der Abruf von fonts.googleapis.com uebertraegt die
		     IP des Besuchers in die USA und ist in DE abmahnfaehig (LG Muenchen I,
		     3 O 17493/20). Bitte nicht wieder einbauen. -->
		<link rel="preload" href="/fonts/Inter-Variable.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/Satisfy-Regular.woff2" as="font" type="font/woff2" crossorigin />
	</head>
	<body class="flex min-h-screen flex-col bg-cream-50 text-ink-700 font-sans antialiased">
		<Header />
		<main class="flex-1">
			<slot />
		</main>
		<Footer />
	</body>
</html>
