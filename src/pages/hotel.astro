---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import BookingWidget from '../components/BookingWidget.astro';
import PhotoGrid from '../components/PhotoGrid.astro';
import { Image } from 'astro:assets';
import zimmer1 from '../assets/gallery/zimmer/zimmer-01.jpg';
import zimmer2 from '../assets/gallery/zimmer/zimmer-02.jpg';
import zimmer3 from '../assets/gallery/zimmer/zimmer-03.jpg';
import zimmer4 from '../assets/gallery/zimmer/zimmer-04.jpg';
import zimmer5 from '../assets/gallery/zimmer/zimmer-05.jpg';
import fruehstueck1 from '../assets/gallery/zimmer/zimmer-11-square.png';
import fruehstueck2 from '../assets/gallery/zimmer/zimmer-12-square.png';

const galerie = [
	{ src: zimmer3, alt: 'Helles Zimmer mit Balkonzugang' },
	{ src: zimmer1, alt: 'Doppelbett unter der Dachschräge' },
	{ src: zimmer2, alt: 'Fenstersitzecke mit Fachwerkbalken' },
	{ src: zimmer4, alt: 'Rustikales Zimmer mit Kunst an der Wand' },
	{ src: zimmer5, alt: 'Modernes, sauberes Badezimmer' },
];

// Infos 1:1 von der Original-Hotel-Seite (wetteraperle.de/hotel)
const infos = [
	{
		title: 'Ankunft und Abreise',
		text: 'Die Anreise kann zwischen 14:00 und 22:00 Uhr flexibel erfolgen. Nach vorheriger Absprache mit uns sind auch andere Zeiten möglich. Ihre Abreise muss bis 11:00 Uhr erfolgt sein. Ihr Gepäck können Sie nach Absprache mit uns im Landgasthof hinterlassen und später abholen.',
	},
	{
		title: 'Stornierungsbedingungen',
		text: 'Bis 7 Tage vor Anreise erheben wir keine Gebühren. Danach wird Ihnen die erste Nacht berechnet.',
	},
	{
		title: 'Zahlungsmethoden',
		text: 'Kreditkarten (Visa, MasterCard, American Express), EC- und Debitkarten sowie Bargeld.',
	},
];
---

<Layout title="Hotel" description="Zimmer und Suiten im Landgasthof Wetteraperle – jetzt Verfügbarkeit prüfen und anfragen.">
	<PageHeader
		kicker="Übernachten"
		title="Zimmer & Suiten"
		description="Unsere Wetteraperle befindet sich inmitten einer idyllischen Landschaft und wir bieten Ihnen Platz für Familien und Paare."
	/>

	<section class="mx-auto max-w-6xl px-6 pt-16 text-center">
		<p class="mx-auto max-w-2xl font-serif text-2xl leading-snug text-ink-900 md:text-3xl">
			„Gastfreundschaft besteht aus ein wenig Wärme, einem guten Essen und viel Ruhe."
		</p>
		<p class="mt-3 text-sm uppercase tracking-[0.3em] text-orange-600">Ralph Waldo Emerson</p>
	</section>

	<section class="mx-auto max-w-6xl px-6 py-16">
		<div class="mb-10 max-w-2xl">
			<p class="font-serif text-sm uppercase tracking-[0.3em] text-orange-600">Verfügbarkeit</p>
			<h2 class="mt-3 font-serif text-3xl font-semibold text-ink-900 md:text-4xl">
				Zimmer wählen & anfragen
			</h2>
			<p class="mt-4 leading-relaxed text-ink-700/80">
				Wählen Sie Ihr Wunschzimmer sowie Ihren Reisezeitraum – wir zeigen Ihnen direkt
				den Gesamtpreis. Wenn Sie sich direkt bei uns melden, können wir für Sie das
				beste Angebot finden.
			</p>
		</div>

		<BookingWidget />
	</section>

	<section class="bg-cream-100/60">
		<div class="mx-auto grid max-w-6xl gap-12 px-6 py-20 md:grid-cols-2 md:items-center">
			<div>
				<p class="font-serif text-sm uppercase tracking-[0.3em] text-orange-600">Guten Morgen</p>
				<h2 class="mt-3 font-serif text-3xl font-semibold text-ink-900 md:text-4xl">Frühstück</h2>
				<p class="mt-4 leading-relaxed text-ink-700/80">
					Für alle unsere Übernachtungsgäste gehört auch ein hausgemachtes Frühstück
					dazu. Dieses wird für jeden Gast von unserem Chefkoch Frank zubereitet.
					Darunter finden Sie nicht nur frische Brötchen, sondern auch hausgemachte
					Marmeladen und Produkte aus der Umgebung. Auch unseren Honig aus eigener
					Bienenhaltung halten wir für Sie bereit. Wir werden die wichtigste Mahlzeit
					für einen guten Start in den Tag so angenehm wie möglich gestalten.
				</p>
			</div>
			<div class="grid grid-cols-2 gap-4">
				<Image
					src={fruehstueck1}
					alt="Frühstück im Freien mit frischen Brötchen und hausgemachter Marmelade"
					class="aspect-square w-full rounded-3xl object-cover"
				/>
				<Image
					src={fruehstueck2}
					alt="Gedeckter Frühstückstisch mit regionalen Produkten"
					class="aspect-square w-full rounded-3xl object-cover md:mt-8"
				/>
			</div>
		</div>
	</section>

	<section class="mx-auto max-w-6xl px-6 py-20">
		<h2 class="mb-8 font-serif text-2xl font-semibold text-ink-900">Gut zu wissen</h2>
		<div class="grid gap-6 md:grid-cols-3">
			{infos.map((info) => (
				<div class="rounded-3xl border border-ink-900/10 bg-white p-8">
					<h3 class="font-serif text-lg font-semibold text-ink-900">{info.title}</h3>
					<p class="mt-3 text-sm leading-relaxed text-ink-700/75">{info.text}</p>
				</div>
			))}
		</div>
	</section>

	<section class="mx-auto max-w-6xl px-6 pb-24">
		<h2 class="mb-8 font-serif text-2xl font-semibold text-ink-900">Impressionen</h2>
		<PhotoGrid images={galerie} />
	</section>
</Layout>
