---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import BookingWidget from '../components/BookingWidget.astro';
import PhotoGrid from '../components/PhotoGrid.astro';
import ZimmerGalerie from '../components/ZimmerGalerie.astro';
import { rooms } from '../data/rooms';
import { Image } from 'astro:assets';
import badDusche from '../assets/gallery/zimmer/bad-dusche.jpg';
import detailHandtuecher from '../assets/gallery/zimmer/detail-handtuecher.jpg';
import treppe from '../assets/gallery/haus/treppe-historisch.jpg';
import gastraum from '../assets/gallery/haus/gastraum-stimmung.jpg';
import fruehstueck1 from '../assets/gallery/fruehstueck/fruehstueck-tisch.jpg';
import fruehstueck2 from '../assets/gallery/fruehstueck/fruehstueck-osaft.jpg';

// Die einzelnen Zimmer haben seit dem Fotoschwung eigene Galerien (siehe unten).
// Hier bleiben nur Motive, die zu keinem bestimmten Zimmertyp gehoeren.
const galerie = [
	{ src: badDusche, alt: 'Modernes Badezimmer mit Dusche und Waschbecken' },
	{ src: detailHandtuecher, alt: 'Frische Handtücher mit süßem Willkommensgruß' },
	{ src: treppe, alt: 'Historische Holztreppe im Landgasthof' },
	{ src: gastraum, alt: 'Gastraum des Landgasthofs am Abend' },
];

// Infos 1:1 von der Original-Hotel-Seite (wetteraperle.de/hotel)
const infos = [
	{
		title: 'Ankunft und Abreise',
		text: 'Die Anreise kann zwischen 14:00 und 22:00 Uhr flexibel erfolgen. Nach vorheriger Absprache mit uns sind auch andere Zeiten möglich. Ihre Abreise muss bis 11:00 Uhr erfolgt sein. Ihr Gepäck können Sie nach Absprache mit uns im Landgasthof hinterlassen und später abholen.',
	},
	{
		title: 'Stornierungsbedingungen',
		text: 'Bis 7 Tage vor Anreise erheben wir keine Gebühren. Danach wird Ihnen die erste Nacht berechnet.',
	},
	{
		title: 'Zahlungsmethoden',
		text: 'Kreditkarten (Visa, MasterCard, American Express), EC- und Debitkarten sowie Bargeld.',
	},
];
---

<Layout title="Hotel" description="Zimmer und Suiten im Landgasthof Wetteraperle – Fotos, Preise und Buchung.">
	<PageHeader
		kicker="Übernachten"
		title="Zimmer & Suiten"
		description="Unsere Wetteraperle befindet sich inmitten einer idyllischen Landschaft und wir bieten Ihnen Platz für Familien und Paare."
	/>

	<section class="mx-auto max-w-6xl px-6 pt-16 text-center">
		<p class="mx-auto max-w-2xl font-akzent text-2xl leading-snug text-ink-900 md:text-3xl">
			„Gastfreundschaft besteht aus ein wenig Wärme, einem guten Essen und viel Ruhe."
		</p>
		<p class="mt-3 text-sm uppercase tracking-[0.3em] text-orange-600">Ralph Waldo Emerson</p>
	</section>

	<section class="mx-auto max-w-6xl px-6 py-16">
		<div class="mb-10 max-w-2xl">
			<p class="font-akzent text-sm uppercase tracking-[0.3em] text-orange-600">Buchung</p>
			<h2 class="mt-3 font-akzent text-3xl font-semibold text-ink-900 md:text-4xl">
				Zimmer buchen
			</h2>
			<p class="mt-4 leading-relaxed text-ink-700/80">
				Alle Zimmer auf einen Blick – Ihre Buchung nehmen wir direkt entgegen, ohne
				Umweg über ein Buchungsportal. Wenn Sie sich direkt bei uns melden, können wir
				für Sie das beste Angebot finden.
			</p>
		</div>

		<BookingWidget />
	</section>

	<section class="border-t border-ink-900/10 bg-white">
		<div class="mx-auto max-w-6xl px-6 py-20">
			<div class="max-w-2xl">
				<p class="font-akzent text-sm uppercase tracking-[0.3em] text-orange-600">Unsere Zimmer</p>
				<h2 class="mt-3 font-akzent text-3xl font-semibold text-ink-900 md:text-4xl">
					Schauen Sie sich in Ruhe um
				</h2>
				<p class="mt-4 leading-relaxed text-ink-700/80">
					Jedes unserer Zimmer ist anders geschnitten – alte Balken, Dachschrägen und
					Fachwerk lassen sich nun einmal nicht in eine Norm pressen. Damit Sie vorher
					genau wissen, worauf Sie sich freuen, finden Sie hier zu jedem Zimmer die
					Fotos. Auf ein Bild klicken, dann wird es gross.
				</p>
			</div>

			<nav class="mt-8 flex flex-wrap gap-2" aria-label="Zu einem Zimmer springen" data-zimmer-nav>
				{rooms.map((room) => (
					<a
						href={`#${room.id}`}
						class="rounded-full border border-ink-900/15 px-4 py-2 text-sm text-ink-700/80 transition-colors hover:border-orange-500 hover:text-orange-600"
					>
						{room.name}
					</a>
				))}
			</nav>

			<div class="mt-14 space-y-20">
				{rooms.map((room, index) => (
					<article id={room.id} class="scroll-mt-28">
						<div class="grid gap-10 lg:grid-cols-2 lg:items-start lg:gap-14">
							<div class={index % 2 === 1 ? 'lg:order-2' : ''}>
								<ZimmerGalerie bilder={room.gallery} name={room.name} />
							</div>

							<div class={index % 2 === 1 ? 'lg:order-1' : ''}>
								<h3 class="font-akzent text-2xl font-semibold text-ink-900 md:text-3xl">
									{room.name}
								</h3>

								<div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-ink-700/70">
									<span>
										bis {room.maxGuests} {room.maxGuests === 1 ? 'Person' : 'Personen'}
									</span>
									{room.size && <span>· {room.size}</span>}
									<span class="font-akzent text-base font-semibold text-orange-600">
										{room.pricePerNight === null
											? '· Preis auf Anfrage'
											: `· ab ${room.pricePerNight} € / Nacht`}
									</span>
								</div>

								<p class="mt-5 leading-relaxed text-ink-700/80">{room.description}</p>

								<ul class="mt-6 grid gap-2 sm:grid-cols-2">
									{room.features.map((feature) => (
										<li class="flex items-start gap-2 text-sm text-ink-700/75">
											<span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-orange-500"></span>
											{feature}
										</li>
									))}
								</ul>

								<div class="mt-8 flex flex-wrap gap-3">
									<a
										href="#booking-widget"
										class="rounded-full bg-orange-500 px-6 py-3 text-sm font-semibold text-cream-50 transition-colors hover:bg-orange-600"
									>
										Zimmer buchen
									</a>
									<a
										href="/kontakt"
										class="rounded-full border border-ink-900/15 px-6 py-3 text-sm font-semibold text-ink-900 transition-colors hover:border-orange-500 hover:text-orange-600"
									>
										Zimmer anfragen
									</a>
								</div>
							</div>
						</div>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="bg-cream-100/60">
		<div class="mx-auto grid max-w-6xl gap-12 px-6 py-20 md:grid-cols-2 md:items-center">
			<div>
				<p class="font-akzent text-sm uppercase tracking-[0.3em] text-orange-600">Guten Morgen</p>
				<h2 class="mt-3 font-akzent text-3xl font-semibold text-ink-900 md:text-4xl">Frühstück</h2>
				<p class="mt-4 leading-relaxed text-ink-700/80">
					Für alle unsere Übernachtungsgäste gehört auch ein hausgemachtes Frühstück
					dazu. Dieses wird für jeden Gast von unserem Chefkoch Frank zubereitet.
					Darunter finden Sie nicht nur frische Brötchen, sondern auch hausgemachte
					Marmeladen und Produkte aus der Umgebung. Auch unseren Honig aus eigener
					Bienenhaltung halten wir für Sie bereit. Wir werden die wichtigste Mahlzeit
					für einen guten Start in den Tag so angenehm wie möglich gestalten.
				</p>
			</div>
			<div class="grid grid-cols-2 gap-4">
				<Image
					src={fruehstueck1}
					alt="Gedeckter Frühstückstisch mit Etagere, frischen Brötchen und Kaffee"
					widths={[400, 800]}
					sizes="(min-width: 768px) 25vw, 50vw"
					format="webp"
					quality={72}
					loading="lazy"
					decoding="async"
					class="aspect-square w-full rounded-3xl object-cover"
				/>
				<Image
					src={fruehstueck2}
					alt="Frisch eingeschenkter Orangensaft zum Frühstück"
					widths={[400, 800]}
					sizes="(min-width: 768px) 25vw, 50vw"
					format="webp"
					quality={72}
					loading="lazy"
					decoding="async"
					class="aspect-square w-full rounded-3xl object-cover md:mt-8"
				/>
			</div>
		</div>
	</section>

	<section class="mx-auto max-w-6xl px-6 py-20">
		<h2 class="mb-8 font-akzent text-2xl font-semibold text-ink-900">Gut zu wissen</h2>
		<div class="grid gap-6 md:grid-cols-3">
			{infos.map((info) => (
				<div class="rounded-3xl border border-ink-900/10 bg-white p-8">
					<h3 class="font-akzent text-lg font-semibold text-ink-900">{info.title}</h3>
					<p class="mt-3 text-sm leading-relaxed text-ink-700/75">{info.text}</p>
				</div>
			))}
		</div>
	</section>

	<section class="mx-auto max-w-6xl px-6 pb-24">
		<h2 class="mb-8 font-akzent text-2xl font-semibold text-ink-900">Rund ums Haus</h2>
		<PhotoGrid images={galerie} />
	</section>
</Layout>

<script>
	/*
	 * Die Zimmerliste ist mehrere Bildschirmhoehen lang. Der global gesetzte
	 * scroll-behavior: smooth bricht auf so langen Strecken ab, sobald unterwegs
	 * lazy geladene Bilder eintrudeln - man landet dann irgendwo dazwischen.
	 * Fuer die Zimmer-Chips springen wir deshalb hart und korrigieren die
	 * Position im naechsten Frame nach.
	 */
	const nav = document.querySelector<HTMLElement>('[data-zimmer-nav]');

	nav?.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((link) => {
		link.addEventListener('click', (event) => {
			const ziel = document.querySelector<HTMLElement>(link.getAttribute('href') ?? '');
			if (!ziel) return;

			event.preventDefault();
			ziel.scrollIntoView({ behavior: 'instant', block: 'start' });
			requestAnimationFrame(() => ziel.scrollIntoView({ behavior: 'instant', block: 'start' }));
			history.replaceState(null, '', link.getAttribute('href'));
		});
	});
</script>
