---
import Layout from '../layouts/Layout.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';

const zimmer = [
	{
		name: 'Komfortzimmer',
		groesse: '22 m²',
		blick: 'Gartenblick',
		beschreibung:
			'Gemütlich eingerichtet für den entspannten Kurzaufenthalt – mit allem, was Sie für eine ruhige Nacht brauchen.',
	},
	{
		name: 'Panoramazimmer',
		groesse: '28 m²',
		blick: 'Bergblick',
		beschreibung:
			'Großzügiger Zimmer mit Balkon und freiem Blick auf die umliegende Bergkulisse.',
	},
	{
		name: 'Wetterperle Suite',
		groesse: '42 m²',
		blick: 'Panoramablick',
		beschreibung:
			'Unsere großzügigste Suite mit separatem Wohnbereich, freistehender Badewanne und privater Terrasse.',
	},
];
---

<Layout title="Zimmer">
	<section class="bg-forest-900">
		<div class="mx-auto max-w-6xl px-6 py-20">
			<p class="font-serif text-sm uppercase tracking-[0.3em] text-gold-400">Unterkunft</p>
			<h1 class="mt-3 font-serif text-4xl font-semibold text-cream-50 md:text-5xl">
				Zimmer & Suiten
			</h1>
			<p class="mt-4 max-w-2xl leading-relaxed text-forest-100">
				Jedes Zimmer im Hotel Wetterperle ist ein Rückzugsort für sich – ruhig, hell und
				mit einem Gespür für die Details, die einen Aufenthalt besonders machen.
			</p>
		</div>
	</section>

	<section class="mx-auto max-w-6xl px-6 py-20">
		<div class="grid gap-10">
			{zimmer.map((zimmer, index) => (
				<div
					class:list={[
						'grid gap-8 md:grid-cols-2 md:items-center',
						index % 2 === 1 && 'md:[&>*:first-child]:order-2',
					]}
				>
					<ImagePlaceholder label={zimmer.name} class="h-64 w-full rounded-2xl md:h-80" />
					<div>
						<h2 class="font-serif text-2xl font-semibold text-forest-700">{zimmer.name}</h2>
						<div class="mt-2 flex gap-4 text-sm font-medium text-gold-600">
							<span>{zimmer.groesse}</span>
							<span>·</span>
							<span>{zimmer.blick}</span>
						</div>
						<p class="mt-4 leading-relaxed text-stone-600">{zimmer.beschreibung}</p>
						<a
							href="/kontakt"
							class="mt-6 inline-block rounded-full bg-forest-700 px-6 py-3 text-sm font-semibold text-cream-50 transition-colors hover:bg-forest-600"
						>
							Zimmer anfragen
						</a>
					</div>
				</div>
			))}
		</div>
	</section>
</Layout>
