---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { openingHours } from '../data/hours';
import { contact } from '../data/nav';
import { Image } from 'astro:assets';
import gastraumStimmung from '../assets/gallery/haus/gastraum-stimmung.jpg';
---

<Layout title="Kontakt" description="Adresse, Öffnungszeiten und Anfrage – so erreichen Sie den Landgasthof Wetteraperle.">
	<PageHeader
		kicker="Wir freuen uns auf Sie"
		title="Kontakt"
		description="Haben Sie Fragen oder möchten Sie ein Zimmer oder einen Tisch anfragen? Wir melden uns schnellstmöglich zurück."
	/>

	<section class="mx-auto max-w-6xl px-6 pt-16">
		<Image
			src={gastraumStimmung}
			alt="Gemütlich eingedeckter Tisch im Gastraum der Wetteraperle"
			class="h-72 w-full rounded-3xl object-cover md:h-96"
		/>
	</section>

	<section class="mx-auto max-w-6xl px-6 py-20">
		<div class="grid gap-12 md:grid-cols-2">
			<div>
				<h2 class="font-serif text-2xl font-semibold text-ink-900">Anfrage senden</h2>
				<form class="mt-6 flex flex-col gap-4" method="post">
					<div class="grid gap-4 sm:grid-cols-2">
						<div>
							<label for="name" class="text-sm font-medium text-ink-900">Name</label>
							<input
								type="text"
								id="name"
								name="name"
								required
								class="mt-1 w-full rounded-lg border border-ink-900/15 px-4 py-2.5 text-sm focus:border-orange-500 focus:outline-none"
							/>
						</div>
						<div>
							<label for="email" class="text-sm font-medium text-ink-900">E-Mail</label>
							<input
								type="email"
								id="email"
								name="email"
								required
								class="mt-1 w-full rounded-lg border border-ink-900/15 px-4 py-2.5 text-sm focus:border-orange-500 focus:outline-none"
							/>
						</div>
					</div>
					<div>
						<label for="betreff" class="text-sm font-medium text-ink-900">Anliegen</label>
						<select
							id="betreff"
							name="betreff"
							class="mt-1 w-full rounded-lg border border-ink-900/15 px-4 py-2.5 text-sm focus:border-orange-500 focus:outline-none"
						>
							<option>Zimmeranfrage</option>
							<option>Tischreservierung</option>
							<option>Feier / Event</option>
							<option>Sonstiges</option>
						</select>
					</div>
					<div>
						<label for="nachricht" class="text-sm font-medium text-ink-900">Nachricht</label>
						<textarea
							id="nachricht"
							name="nachricht"
							rows="5"
							class="mt-1 w-full rounded-lg border border-ink-900/15 px-4 py-2.5 text-sm focus:border-orange-500 focus:outline-none"
						></textarea>
					</div>
					<button
						type="submit"
						class="mt-2 self-start rounded-full bg-orange-500 px-7 py-3 text-sm font-semibold text-cream-50 transition-colors hover:bg-orange-600"
					>
						Anfrage senden
					</button>
					<p class="text-xs text-ink-700/60">
						Hinweis: Dieses Formular ist aktuell noch nicht mit einem Versanddienst verbunden.
					</p>
				</form>
			</div>

			<div>
				<h2 class="font-serif text-2xl font-semibold text-ink-900">So erreichen Sie uns</h2>
				<ul class="mt-6 space-y-4 text-sm text-ink-700/80">
					<li>
						<span class="block font-medium text-ink-900">Adresse</span>
						{contact.street}, {contact.zipCity}
					</li>
					<li>
						<span class="block font-medium text-ink-900">Telefon</span>
						<a href={contact.phoneHref} class="hover:text-orange-600">{contact.phoneDisplay}</a>
					</li>
					<li>
						<span class="block font-medium text-ink-900">E-Mail</span>
						<a href={`mailto:${contact.email}`} class="hover:text-orange-600">{contact.email}</a>
					</li>
				</ul>

				<h3 class="mt-8 font-serif text-lg font-semibold text-ink-900">Öffnungszeiten</h3>
				<ul class="mt-3 space-y-2 text-sm">
					{openingHours.map((entry) => (
						<li class="flex justify-between gap-4">
							<span class="font-medium text-ink-900">{entry.label}</span>
							<span class="text-ink-700/70">{entry.ranges ? entry.ranges.join(' · ') : 'Ruhetag'}</span>
						</li>
					))}
				</ul>

				<div class="mt-8 overflow-hidden rounded-2xl border border-ink-900/10">
					<iframe
						src={contact.mapEmbedSrc}
						class="h-64 w-full"
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						title="Standort Landgasthof Wetteraperle"
					></iframe>
				</div>
			</div>
		</div>
	</section>
</Layout>
