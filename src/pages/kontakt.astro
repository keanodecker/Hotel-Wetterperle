---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Kontakt">
	<section class="bg-forest-900">
		<div class="mx-auto max-w-6xl px-6 py-20">
			<p class="font-serif text-sm uppercase tracking-[0.3em] text-gold-400">Wir freuen uns auf Sie</p>
			<h1 class="mt-3 font-serif text-4xl font-semibold text-cream-50 md:text-5xl">Kontakt</h1>
			<p class="mt-4 max-w-2xl leading-relaxed text-forest-100">
				Haben Sie Fragen oder möchten Sie ein Zimmer anfragen? Wir melden uns schnellstmöglich
				bei Ihnen zurück.
			</p>
		</div>
	</section>

	<section class="mx-auto max-w-6xl px-6 py-20">
		<div class="grid gap-12 md:grid-cols-2">
			<div>
				<h2 class="font-serif text-2xl font-semibold text-forest-700">Anfrage senden</h2>
				<form class="mt-6 flex flex-col gap-4" method="post">
					<div class="grid gap-4 sm:grid-cols-2">
						<div>
							<label for="name" class="text-sm font-medium text-stone-700">Name</label>
							<input
								type="text"
								id="name"
								name="name"
								required
								class="mt-1 w-full rounded-lg border border-forest-100 px-4 py-2.5 text-sm focus:border-forest-400 focus:outline-none"
							/>
						</div>
						<div>
							<label for="email" class="text-sm font-medium text-stone-700">E-Mail</label>
							<input
								type="email"
								id="email"
								name="email"
								required
								class="mt-1 w-full rounded-lg border border-forest-100 px-4 py-2.5 text-sm focus:border-forest-400 focus:outline-none"
							/>
						</div>
					</div>
					<div class="grid gap-4 sm:grid-cols-2">
						<div>
							<label for="anreise" class="text-sm font-medium text-stone-700">Anreise</label>
							<input
								type="date"
								id="anreise"
								name="anreise"
								class="mt-1 w-full rounded-lg border border-forest-100 px-4 py-2.5 text-sm focus:border-forest-400 focus:outline-none"
							/>
						</div>
						<div>
							<label for="abreise" class="text-sm font-medium text-stone-700">Abreise</label>
							<input
								type="date"
								id="abreise"
								name="abreise"
								class="mt-1 w-full rounded-lg border border-forest-100 px-4 py-2.5 text-sm focus:border-forest-400 focus:outline-none"
							/>
						</div>
					</div>
					<div>
						<label for="nachricht" class="text-sm font-medium text-stone-700">Nachricht</label>
						<textarea
							id="nachricht"
							name="nachricht"
							rows="5"
							class="mt-1 w-full rounded-lg border border-forest-100 px-4 py-2.5 text-sm focus:border-forest-400 focus:outline-none"
						></textarea>
					</div>
					<button
						type="submit"
						class="mt-2 self-start rounded-full bg-forest-700 px-7 py-3 text-sm font-semibold text-cream-50 transition-colors hover:bg-forest-600"
					>
						Anfrage senden
					</button>
					<p class="text-xs text-stone-500">
						Hinweis: Dieses Formular ist aktuell noch nicht mit einem Versanddienst verbunden.
					</p>
				</form>
			</div>

			<div>
				<h2 class="font-serif text-2xl font-semibold text-forest-700">So erreichen Sie uns</h2>
				<ul class="mt-6 space-y-4 text-sm text-stone-600">
					<li>
						<span class="block font-medium text-forest-700">Adresse</span>
						Wetterperlenweg 12, 87534 Bergstetten
					</li>
					<li>
						<span class="block font-medium text-forest-700">Telefon</span>
						+49 (0) 8321 123 456
					</li>
					<li>
						<span class="block font-medium text-forest-700">E-Mail</span>
						info@hotel-wetterperle.de
					</li>
					<li>
						<span class="block font-medium text-forest-700">Rezeption</span>
						täglich von 07:00 – 21:00 Uhr
					</li>
				</ul>

				<div class="mt-8 flex h-64 items-center justify-center rounded-2xl bg-forest-50 text-sm font-medium text-forest-600">
					Kartenansicht folgt
				</div>
			</div>
		</div>
	</section>
</Layout>
