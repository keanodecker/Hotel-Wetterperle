---
import Layout from '../layouts/Layout.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';

const bilder = [
	'Empfang & Lobby',
	'Panoramazimmer',
	'Wetterperle Suite',
	'Restaurant',
	'Terrasse',
	'Wellnessbereich',
	'Außenansicht',
	'Bergblick',
	'Frühstücksraum',
];
---

<Layout title="Galerie">
	<section class="bg-forest-900">
		<div class="mx-auto max-w-6xl px-6 py-20">
			<p class="font-serif text-sm uppercase tracking-[0.3em] text-gold-400">Impressionen</p>
			<h1 class="mt-3 font-serif text-4xl font-semibold text-cream-50 md:text-5xl">Galerie</h1>
			<p class="mt-4 max-w-2xl leading-relaxed text-forest-100">
				Ein erster Eindruck vom Hotel Wetterperle – Fotos folgen in Kürze.
			</p>
		</div>
	</section>

	<section class="mx-auto max-w-6xl px-6 py-20">
		<div class="grid gap-6 sm:grid-cols-2 md:grid-cols-3">
			{bilder.map((label) => (
				<ImagePlaceholder label={label} class="aspect-[4/3] w-full rounded-2xl" />
			))}
		</div>
	</section>
</Layout>
