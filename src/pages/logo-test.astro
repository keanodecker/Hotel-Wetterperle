---
// TEMPORÄRE Testseite v3 (12.08.2026) — zeigt GENAU den jetzt live geschalteten
// Stand (altes „scharfes" Logo-Bild + dünne 0.5px-Kontur), einmal in Hero-Größe
// und einmal vergrößert. Nur lokal, wird nach KDs Bestätigung gelöscht.
import { Image } from 'astro:assets';
import hero from '../assets/extracted/hero.jpg';
import logoMark from '../assets/extracted/logo-mark.png';

const kontur =
	'drop-shadow(0.5px 0 0 rgba(255,255,255,0.8)) drop-shadow(-0.5px 0 0 rgba(255,255,255,0.8)) drop-shadow(0 0.5px 0 rgba(255,255,255,0.8)) drop-shadow(0 -0.5px 0 rgba(255,255,255,0.8)) drop-shadow(0 8px 10px rgba(0,0,0,0.3))';
---

<html lang="de">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
		<title>Logo-Test v3 — der Live-Stand</title>
	</head>
	<body style="margin:0; font-family: system-ui, sans-serif;">
		<p style="padding: 16px 24px; margin: 0; font-size: 18px; background: #fff;">
			<strong>Das ist der Stand, der jetzt live ist</strong> — altes „scharfes" Logo + dünne Linie.
			Links wie im Hero (128&nbsp;px), rechts vergrößert. Ist DAS das Bild, das du meinst?
		</p>
		<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0;">
			{[128, 300].map((groesse) => (
				<div style="position: relative; min-height: 460px; overflow: hidden;">
					<Image src={hero} alt="" widths={[1000]} sizes="50vw" style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 30%;" />
					<div style="position: absolute; inset: 0; background: rgba(15,20,20,0.45);"></div>
					<div style="position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; height: 460px; gap: 18px;">
						<Image src={logoMark} alt="" width={360} height={414} format="png" style={`height: ${groesse}px; width: auto; filter: ${kontur};`} />
						<span style="color: #fff; background: rgba(0,0,0,0.55); padding: 6px 14px; border-radius: 999px; font-size: 15px;">
							{groesse === 128 ? 'Wie im Hero (128 px)' : 'Vergrößert (300 px)'}
						</span>
					</div>
				</div>
			))}
		</div>
	</body>
</html>
