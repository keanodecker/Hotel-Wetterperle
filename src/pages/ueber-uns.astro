---
import Layout from '../layouts/Layout.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';

const werte = [
	{
		title: 'Herzlichkeit',
		text: 'Wir empfangen jeden Gast wie einen Freund – aufmerksam, persönlich und ohne Distanz.',
	},
	{
		title: 'Regionalität',
		text: 'Von der Küche bis zur Einrichtung setzen wir auf Partner und Produkte aus der Region.',
	},
	{
		title: 'Ruhe',
		text: 'Kein Trubel, keine Eile – bei uns darf die Zeit langsamer vergehen.',
	},
];
---

<Layout title="Über uns">
	<section class="bg-forest-900">
		<div class="mx-auto max-w-6xl px-6 py-20">
			<p class="font-serif text-sm uppercase tracking-[0.3em] text-gold-400">Unsere Geschichte</p>
			<h1 class="mt-3 font-serif text-4xl font-semibold text-cream-50 md:text-5xl">Über uns</h1>
			<p class="mt-4 max-w-2xl leading-relaxed text-forest-100">
				Das Hotel Wetterperle ist mehr als eine Adresse – es ist ein Ort, an dem Gastfreundschaft
				seit Generationen gelebt wird.
			</p>
		</div>
	</section>

	<section class="mx-auto max-w-6xl px-6 py-20">
		<div class="grid gap-10 md:grid-cols-2 md:items-center">
			<ImagePlaceholder label="Historisches Foto Hotel Wetterperle" class="h-72 w-full rounded-2xl md:h-96" />
			<div>
				<p class="font-serif text-sm uppercase tracking-[0.3em] text-gold-600">Tradition</p>
				<h2 class="mt-3 font-serif text-3xl font-semibold text-forest-700 md:text-4xl">
					Eine Familie, ein Versprechen
				</h2>
				<p class="mt-4 leading-relaxed text-stone-600">
					Was einst als kleines Gasthaus begann, ist heute ein Hotel, das Tradition und
					Komfort miteinander verbindet. Über die Jahre haben wir das Haus behutsam
					weiterentwickelt – immer mit dem Ziel, unseren Gästen ein echtes Zuhause auf
					Zeit zu bieten.
				</p>
				<p class="mt-4 leading-relaxed text-stone-600">
					Bis heute führen wir das Hotel Wetterperle mit derselben Sorgfalt und
					Leidenschaft, mit der alles begonnen hat.
				</p>
			</div>
		</div>
	</section>

	<section class="bg-forest-50">
		<div class="mx-auto max-w-6xl px-6 py-20">
			<p class="font-serif text-sm uppercase tracking-[0.3em] text-gold-600">Was uns wichtig ist</p>
			<h2 class="mt-3 font-serif text-3xl font-semibold text-forest-700 md:text-4xl">
				Unsere Werte
			</h2>
			<div class="mt-10 grid gap-8 md:grid-cols-3">
				{werte.map((wert) => (
					<div class="rounded-2xl border border-forest-100 bg-white p-8">
						<h3 class="font-serif text-xl font-semibold text-forest-700">{wert.title}</h3>
						<p class="mt-3 text-sm leading-relaxed text-stone-600">{wert.text}</p>
					</div>
				))}
			</div>
		</div>
	</section>
</Layout>
