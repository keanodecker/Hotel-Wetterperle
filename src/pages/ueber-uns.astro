---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { Image } from 'astro:assets';
import owners from '../assets/extracted/owners.jpg';
import treppe from '../assets/gallery/haus/treppe-historisch.jpg';
import feengrotten from '../assets/gallery/umgebung/feengrotten.jpg';
import saaleschleife from '../assets/gallery/umgebung/saaleschleife-burgk.jpg';
import wildwasserbahn from '../assets/gallery/umgebung/wildwasserbahn-plohn.jpg';

const ausflugsziele = [
	{
		title: 'Feengrotten Saalfeld',
		text: 'Das farbenreichste Schauhöhlensystem der Welt – ein unterirdisches Naturwunder ganz in der Nähe.',
		image: feengrotten,
	},
	{
		title: 'Saaleschleife bei Burgk',
		text: 'Einer der schönsten Aussichtspunkte Thüringens, mit Blick auf die geschwungene Saale.',
		image: saaleschleife,
	},
	{
		title: 'Freizeitpark Plohn',
		text: 'Wildwasserbahn und Fahrattraktionen für einen actionreichen Familientag.',
		image: wildwasserbahn,
	},
];

const zeitstrahl = [
	{ zeit: '19. Jh. – 1945', text: 'Das Gebäude dient als Getreidemühle mit günstiger Flussanbindung.' },
	{ zeit: 'Nach 1945', text: 'Nutzung als landwirtschaftlicher Betrieb (LPG).' },
	{ zeit: 'Ab 1994', text: 'Das Haus wird zum privat geführten Gasthaus.' },
	{ zeit: '2010 – 2019', text: 'Das Gebäude steht nahezu leer.' },
	{ zeit: 'Seit 2018/19', text: 'Frank und Nadine Gröters übernehmen und hauchen der Wetteraperle neuen Charme ein.' },
];

const werte = [
	{
		title: 'Qualität & Handwerk',
		text: 'Frank bereitet alle Speisen selbst zu – mit Fokus auf Steaks, leichte Salate und innovative Kreationen.',
	},
	{
		title: 'Nachhaltigkeit',
		text: 'Zutaten von lokalen Bauern, Fleisch aus der Umgebung, eigener Honig – immer saisonal gedacht.',
	},
	{
		title: 'Gastfreundlichkeit',
		text: 'Wanderer, Radfahrer und Einheimische sind gleichermaßen willkommen – inklusive fünf Wohnmobilstellplätzen.',
	},
];
---

<Layout title="Über uns" description="Die Geschichte des Landgasthofs Wetteraperle und seiner Inhaber Frank und Nadine Gröters.">
	<PageHeader
		kicker="Unsere Geschichte"
		title="Über uns"
		description="Vom historischen Mühlengebäude zum familiengeführten Landgasthof – eine Geschichte mit vielen Kapiteln."
	/>

	<section class="mx-auto grid max-w-6xl gap-12 px-6 py-20 md:grid-cols-2 md:items-center">
		<Image
			src={owners}
			alt="Frank und Nadine Gröters"
			class="h-72 w-72 justify-self-center rounded-full object-cover shadow-xl ring-8 ring-white"
		/>
		<div>
			<p class="font-akzent text-sm uppercase tracking-[0.3em] text-orange-600">Die Inhaber</p>
			<h2 class="mt-3 font-akzent text-3xl font-semibold text-ink-900 md:text-4xl">
				Frank &amp; Nadine Gröters
			</h2>
			<p class="mt-4 leading-relaxed text-ink-700/80">
				Nach einer längeren Pause übernahmen Frank und Nadine Gröters die Wetteraperle
				und wollten dem Gasthof „wieder ihren alten Charme einhauchen und neue
				Impulse" setzen. Sie bringen Erfahrung aus Berlin und vom Tegernsee mit – Frank
				ist gelernter Koch mit über 30 Jahren Erfahrung.
			</p>
		</div>
	</section>

	<section class="bg-ink-900">
		<div class="mx-auto max-w-5xl px-6 py-20">
			<h2 class="mb-12 text-center font-akzent text-3xl font-semibold text-cream-50 md:text-4xl">
				Ein Gebäude mit Geschichte
			</h2>
			<div class="grid gap-12 md:grid-cols-[1fr_1.2fr] md:items-center">
				<Image
					src={treppe}
					alt="Historische Holztreppe im Landgasthof Wetteraperle"
					class="h-80 w-full rounded-3xl object-cover md:h-[28rem]"
				/>
				<ol class="space-y-8 border-l border-cream-50/20 pl-8">
					{zeitstrahl.map((station) => (
						<li class="relative">
							<span class="absolute -left-[2.15rem] top-1.5 h-3 w-3 rounded-full bg-orange-500"></span>
							<p class="font-akzent text-sm font-semibold uppercase tracking-wider text-orange-400">{station.zeit}</p>
							<p class="mt-1 text-cream-100/80">{station.text}</p>
						</li>
					))}
				</ol>
			</div>
		</div>
	</section>

	<section class="mx-auto max-w-6xl px-6 py-20">
		<h2 class="mb-12 text-center font-akzent text-3xl font-semibold text-ink-900 md:text-4xl">
			Wofür wir stehen
		</h2>
		<div class="grid gap-8 md:grid-cols-3">
			{werte.map((wert) => (
				<div class="rounded-2xl border border-ink-900/10 bg-white p-8">
					<h3 class="font-akzent text-xl font-semibold text-ink-900">{wert.title}</h3>
					<p class="mt-3 text-sm leading-relaxed text-ink-700/80">{wert.text}</p>
				</div>
			))}
		</div>
	</section>

	<section class="bg-cream-100/60">
		<div class="mx-auto max-w-6xl px-6 py-20">
			<div class="mb-12 max-w-2xl">
				<p class="font-akzent text-sm uppercase tracking-[0.3em] text-orange-600">Mitten in der Natur</p>
				<h2 class="mt-3 font-akzent text-3xl font-semibold text-ink-900 md:text-4xl">
					Ausflugsziele in der Umgebung
				</h2>
				<p class="mt-4 leading-relaxed text-ink-700/80">
					Das Thüringer Schiefergebirge und seine Umgebung bieten Ausflugsziele für
					jeden Geschmack – ideal als Ausgangspunkt für Wanderer, Familien und
					Entdecker.
				</p>
			</div>
			<div class="grid gap-8 md:grid-cols-3">
				{ausflugsziele.map((ziel) => (
					<div class="overflow-hidden rounded-2xl border border-ink-900/10 bg-white">
						<Image src={ziel.image} alt={ziel.title} class="h-48 w-full object-cover" />
						<div class="p-6">
							<h3 class="font-akzent text-lg font-semibold text-ink-900">{ziel.title}</h3>
							<p class="mt-2 text-sm leading-relaxed text-ink-700/80">{ziel.text}</p>
						</div>
					</div>
				))}
			</div>
		</div>
	</section>
</Layout>
