---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { contact } from '../data/nav';

const fakten = [
	{ label: 'Standort', value: 'Raila 11, 07929 Saalburg-Ebersdorf, Thüringen' },
	{ label: 'Inhaber', value: 'Frank & Nadine Gröters, seit 2018/19' },
	{ label: 'Küchenchef', value: 'Frank Gröters, über 30 Jahre Erfahrung (Berlin, Tegernsee)' },
	{ label: 'Gebäude', value: 'Ehemalige Getreidemühle, seit dem 19. Jahrhundert am selben Standort' },
	{ label: 'Zimmerkategorien', value: 'Einzel-, Doppel-, Familienzimmer und Familien-Suite' },
	{ label: 'Besonderheiten', value: 'Biergarten am Teich, Festsaal, 5 Wohnmobilstellplätze' },
];

const auszeichnungen = [
	{ title: '4,9 / 5', text: 'Durchschnittliche Google- und RestaurantGuru-Bewertung' },
	{ title: '#1 Restaurant', text: 'In Saalburg-Ebersdorf laut Tripadvisor' },
	{ title: '9,2 „Großartig"', text: 'Hotelbewertung auf Kayak, aus über 700 Bewertungen' },
];
---

<Layout title="Presse" description="Pressematerial, Fakten und Auszeichnungen des Landgasthofs Wetteraperle.">
	<PageHeader
		kicker="Für Medien"
		title="Presse"
		description="Fakten, Zahlen und Ansprechpartner für Presseanfragen rund um den Landgasthof Wetteraperle."
	/>

	<section class="mx-auto max-w-6xl px-6 py-20">
		<h2 class="mb-8 font-serif text-2xl font-semibold text-ink-900">Fakten auf einen Blick</h2>
		<dl class="grid gap-6 sm:grid-cols-2">
			{fakten.map((fakt) => (
				<div class="rounded-2xl border border-ink-900/10 bg-white p-6">
					<dt class="text-xs font-semibold uppercase tracking-wider text-orange-600">{fakt.label}</dt>
					<dd class="mt-2 text-sm leading-relaxed text-ink-900">{fakt.value}</dd>
				</div>
			))}
		</dl>
	</section>

	<section class="bg-ink-900">
		<div class="mx-auto max-w-6xl px-6 py-20">
			<h2 class="mb-10 font-serif text-2xl font-semibold text-cream-50">Auszeichnungen</h2>
			<div class="grid gap-8 sm:grid-cols-3">
				{auszeichnungen.map((item) => (
					<div class="rounded-2xl bg-cream-50/5 p-8 text-center ring-1 ring-cream-50/10">
						<p class="font-serif text-3xl font-semibold text-orange-400">{item.title}</p>
						<p class="mt-2 text-sm text-cream-100/80">{item.text}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<section class="mx-auto max-w-4xl px-6 py-20">
		<div class="grid gap-10 rounded-3xl border border-ink-900/10 bg-white p-10 md:grid-cols-2">
			<div>
				<h2 class="font-serif text-2xl font-semibold text-ink-900">Pressekontakt</h2>
				<p class="mt-3 text-sm leading-relaxed text-ink-700/80">
					Für Presseanfragen, Interviewwünsche oder Bildmaterial wenden Sie sich gerne
					direkt an uns.
				</p>
				<ul class="mt-4 space-y-2 text-sm">
					<li>
						<a href={`mailto:${contact.email}`} class="font-semibold text-orange-600">{contact.email}</a>
					</li>
					<li>
						<a href={contact.phoneHref} class="font-semibold text-orange-600">{contact.phoneDisplay}</a>
					</li>
				</ul>
			</div>
			<div>
				<h2 class="font-serif text-2xl font-semibold text-ink-900">Bildmaterial</h2>
				<p class="mt-3 text-sm leading-relaxed text-ink-700/80">
					Ein Presse-Kit mit Logo und Fotomaterial in Druckqualität folgt in Kürze.
				</p>
				<span
					class="mt-4 inline-block cursor-not-allowed rounded-full border border-ink-900/20 px-6 py-3 text-sm font-semibold text-ink-900/40"
					aria-disabled="true"
				>
					Presse-Kit (bald verfügbar)
				</span>
			</div>
		</div>
	</section>
</Layout>
